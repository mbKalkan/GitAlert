<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xunit v3 test projects are executables. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>GitAlert.Tests</RootNamespace>
    <!-- The tests own their timeouts; the analyzer would have every call take the runner token. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <!-- On Windows the suite still covers the WPF front end, so it targets Windows and references
       that project. On macOS and Linux, where WPF cannot build, the same suite runs against the
       core and the Windows layer's portable parts, without the WPF-bound tests. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <PropertyGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ProjectReference Include="..\..\src\GitAlert\GitAlert.csproj" />
  </ItemGroup>

  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <ProjectReference Include="..\..\src\GitAlert.Core\GitAlert.Core.csproj" />
    <ProjectReference Include="..\..\src\GitAlert.Windows\GitAlert.Windows.csproj" />
    <Compile Remove="PasswordBoxBinderTests.cs" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xunit v3 test projects are executables. -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>GitAlert.Tests</RootNamespace>
    <!-- The tests own their timeouts; the analyzer would have every call take the runner token. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <!-- The core and the Windows layer's portable parts; the windows themselves are covered by
       tests/GitAlert.UI.Tests. Nothing here needs a display, so the suite runs on every OS. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\GitAlert.Core\GitAlert.Core.csproj" />
    <ProjectReference Include="..\..\src\GitAlert.Windows\GitAlert.Windows.csproj" />
  </ItemGroup>

</Project>

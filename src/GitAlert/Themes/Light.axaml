<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Light palette. Same keys as Dark.xaml, so the two dictionaries are interchangeable
       at runtime without touching a single control style. -->

  <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SurfaceElevated" Color="#F6F8FA" />
  <SolidColorBrush x:Key="SurfaceHover" Color="#EFF2F5" />
  <SolidColorBrush x:Key="SurfaceSunken" Color="#F6F8FA" />

  <SolidColorBrush x:Key="Border" Color="#D8DEE4" />
  <SolidColorBrush x:Key="BorderSubtle" Color="#E8EBEF" />

  <SolidColorBrush x:Key="TextPrimary" Color="#1F2328" />
  <SolidColorBrush x:Key="TextSecondary" Color="#59636E" />
  <SolidColorBrush x:Key="TextMuted" Color="#848D97" />

  <SolidColorBrush x:Key="Accent" Color="#0969DA" />
  <SolidColorBrush x:Key="AccentHover" Color="#0A5FC2" />
  <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AccentSubtle" Color="#DDEBFC" />

  <SolidColorBrush x:Key="Danger" Color="#CF222E" />
  <SolidColorBrush x:Key="Success" Color="#1A7F37" />

  <SolidColorBrush x:Key="ChipBackground" Color="#F0F3F6" />
  <SolidColorBrush x:Key="ChipHover" Color="#E6EAEF" />

  <SolidColorBrush x:Key="ControlBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ScrollThumb" Color="#C9D1D9" />
  <SolidColorBrush x:Key="ScrollThumbHover" Color="#AFB8C1" />

  <!-- Diff colours. Deliberately close to what GitHub itself uses, so a diff read here and a
       diff read in a browser do not look like two different changes. -->
  <SolidColorBrush x:Key="DiffAddedBackground" Color="#E6FFEC" />
  <SolidColorBrush x:Key="DiffAddedAccent" Color="#1A7F37" />
  <SolidColorBrush x:Key="DiffRemovedBackground" Color="#FFEBE9" />
  <SolidColorBrush x:Key="DiffRemovedAccent" Color="#CF222E" />
  <SolidColorBrush x:Key="DiffHunkBackground" Color="#F1F5F9" />
  <SolidColorBrush x:Key="DiffHunkText" Color="#57677A" />
  <SolidColorBrush x:Key="DiffGutterText" Color="#8C959F" />
  <SolidColorBrush x:Key="DiffCodeText" Color="#1F2328" />

  <!-- The glyph on each alert card, by kind, and the severity that overrides it. -->
  <SolidColorBrush x:Key="KindPush" Color="#4C8DF6" />
  <SolidColorBrush x:Key="KindPullRequest" Color="#A371F7" />
  <SolidColorBrush x:Key="KindIssue" Color="#34A853" />
  <SolidColorBrush x:Key="KindComment" Color="#8993A1" />
  <SolidColorBrush x:Key="KindReview" Color="#34A853" />
  <SolidColorBrush x:Key="KindRelease" Color="#DB6D28" />
  <SolidColorBrush x:Key="KindBranch" Color="#589CF0" />
  <SolidColorBrush x:Key="KindWorkflow" Color="#8993A1" />
  <SolidColorBrush x:Key="KindStar" Color="#D4A022" />
  <SolidColorBrush x:Key="KindFork" Color="#8993A1" />
  <SolidColorBrush x:Key="KindMention" Color="#E066A6" />
  <SolidColorBrush x:Key="KindOther" Color="#8993A1" />
  <SolidColorBrush x:Key="SeveritySuccess" Color="#34A853" />
  <SolidColorBrush x:Key="SeverityWarning" Color="#C7931F" />
  <SolidColorBrush x:Key="SeverityError" Color="#E5534B" />

  <!-- The dot beside the status line in the header. -->
  <SolidColorBrush x:Key="StatusConnected" Color="#34A853" />
  <SolidColorBrush x:Key="StatusWorking" Color="#589CF0" />
  <SolidColorBrush x:Key="StatusWarning" Color="#C7931F" />
  <SolidColorBrush x:Key="StatusError" Color="#E5534B" />
  <SolidColorBrush x:Key="StatusIdle" Color="#8993A1" />

  <Color x:Key="ShadowColor">#3D4A5C</Color>
  <x:Double x:Key="ShadowOpacity">0.28</x:Double>


  <!-- Fluent draws the combo box and its drop-down from these; aliased so they follow the palette. -->
  <CornerRadius x:Key="ControlCornerRadius">7</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
  <StaticResource x:Key="ComboBoxBackground" ResourceKey="ControlBackground" />
  <StaticResource x:Key="ComboBoxBackgroundPointerOver" ResourceKey="ControlBackground" />
  <StaticResource x:Key="ComboBoxBackgroundPressed" ResourceKey="ControlBackground" />
  <StaticResource x:Key="ComboBoxBackgroundDisabled" ResourceKey="ControlBackground" />
  <StaticResource x:Key="ComboBoxBorderBrush" ResourceKey="Border" />
  <StaticResource x:Key="ComboBoxBorderBrushPointerOver" ResourceKey="TextMuted" />
  <StaticResource x:Key="ComboBoxBorderBrushPressed" ResourceKey="Accent" />
  <StaticResource x:Key="ComboBoxForeground" ResourceKey="TextPrimary" />
  <StaticResource x:Key="ComboBoxForegroundPointerOver" ResourceKey="TextPrimary" />
  <StaticResource x:Key="ComboBoxForegroundPressed" ResourceKey="TextPrimary" />
  <StaticResource x:Key="ComboBoxForegroundFocused" ResourceKey="TextPrimary" />
  <StaticResource x:Key="ComboBoxDropDownBackground" ResourceKey="SurfaceElevated" />
  <StaticResource x:Key="ComboBoxDropDownBorderBrush" ResourceKey="Border" />
  <StaticResource x:Key="ComboBoxDropDownGlyphForeground" ResourceKey="TextSecondary" />
  <StaticResource x:Key="ComboBoxItemForeground" ResourceKey="TextPrimary" />
  <StaticResource x:Key="ComboBoxItemForegroundPointerOver" ResourceKey="TextPrimary" />
  <StaticResource x:Key="ComboBoxItemForegroundSelected" ResourceKey="TextPrimary" />
  <StaticResource x:Key="ComboBoxItemForegroundSelectedPointerOver" ResourceKey="TextPrimary" />
  <StaticResource x:Key="ComboBoxItemBackgroundPointerOver" ResourceKey="SurfaceHover" />
  <StaticResource x:Key="ComboBoxItemBackgroundSelected" ResourceKey="AccentSubtle" />
  <StaticResource x:Key="ComboBoxItemBackgroundSelectedPointerOver" ResourceKey="AccentSubtle" />
  <StaticResource x:Key="ComboBoxItemBackgroundSelectedPressed" ResourceKey="AccentSubtle" />

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Dark palette. Values follow GitHub's dark theme closely enough to feel native
       next to the site the alerts come from. -->

  <SolidColorBrush x:Key="Surface" Color="#161B22" />
  <SolidColorBrush x:Key="SurfaceElevated" Color="#1C222B" />
  <SolidColorBrush x:Key="SurfaceHover" Color="#232A34" />
  <SolidColorBrush x:Key="SurfaceSunken" Color="#0D1117" />

  <SolidColorBrush x:Key="Border" Color="#30363D" />
  <SolidColorBrush x:Key="BorderSubtle" Color="#242B33" />

  <SolidColorBrush x:Key="TextPrimary" Color="#E6EDF3" />
  <SolidColorBrush x:Key="TextSecondary" Color="#9BA6B2" />
  <SolidColorBrush x:Key="TextMuted" Color="#6E7681" />

  <SolidColorBrush x:Key="Accent" Color="#3B82F6" />
  <SolidColorBrush x:Key="AccentHover" Color="#5A97F8" />
  <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AccentSubtle" Color="#1D2C44" />

  <SolidColorBrush x:Key="Danger" Color="#E5534B" />
  <SolidColorBrush x:Key="Success" Color="#34A853" />

  <SolidColorBrush x:Key="ChipBackground" Color="#232A34" />
  <SolidColorBrush x:Key="ChipHover" Color="#2C333E" />

  <SolidColorBrush x:Key="ControlBackground" Color="#0D1117" />
  <SolidColorBrush x:Key="ScrollThumb" Color="#3B444F" />
  <SolidColorBrush x:Key="ScrollThumbHover" Color="#4C5866" />

  <!-- Diff colours. Deliberately close to what GitHub itself uses, so a diff read here and a
       diff read in a browser do not look like two different changes. -->
  <SolidColorBrush x:Key="DiffAddedBackground" Color="#12261E" />
  <SolidColorBrush x:Key="DiffAddedAccent" Color="#2EA043" />
  <SolidColorBrush x:Key="DiffRemovedBackground" Color="#25171C" />
  <SolidColorBrush x:Key="DiffRemovedAccent" Color="#F85149" />
  <SolidColorBrush x:Key="DiffHunkBackground" Color="#151B23" />
  <SolidColorBrush x:Key="DiffHunkText" Color="#6E8BB0" />
  <SolidColorBrush x:Key="DiffGutterText" Color="#5A636D" />
  <SolidColorBrush x:Key="DiffCodeText" Color="#D5DEE7" />

  <Color x:Key="ShadowColor">#000000</Color>
  <system:Double xmlns:system="clr-namespace:System;assembly=System.Runtime" x:Key="ShadowOpacity">0.55</system:Double>

</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- The default dark palette: VS Code's Dark Modern. Neutral greys and a single blue, so the
       window sits quietly beside the editor most of its alerts end up in. GitHub's own dark
       palette lives in DarkGitHub.xaml and is a setting away. -->

  <SolidColorBrush x:Key="Surface" Color="#1F1F1F" />
  <SolidColorBrush x:Key="SurfaceElevated" Color="#181818" />
  <SolidColorBrush x:Key="SurfaceHover" Color="#2A2D2E" />
  <SolidColorBrush x:Key="SurfaceSunken" Color="#161616" />

  <SolidColorBrush x:Key="Border" Color="#2B2B2B" />
  <SolidColorBrush x:Key="BorderSubtle" Color="#262626" />

  <SolidColorBrush x:Key="TextPrimary" Color="#CCCCCC" />
  <SolidColorBrush x:Key="TextSecondary" Color="#9D9D9D" />
  <SolidColorBrush x:Key="TextMuted" Color="#767676" />

  <SolidColorBrush x:Key="Accent" Color="#0078D4" />
  <SolidColorBrush x:Key="AccentHover" Color="#3B9BE5" />
  <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AccentSubtle" Color="#0E3653" />

  <SolidColorBrush x:Key="Danger" Color="#F14C4C" />
  <SolidColorBrush x:Key="Success" Color="#89D185" />

  <SolidColorBrush x:Key="ChipBackground" Color="#2B2B2B" />
  <SolidColorBrush x:Key="ChipHover" Color="#373737" />

  <SolidColorBrush x:Key="ControlBackground" Color="#161616" />
  <SolidColorBrush x:Key="ScrollThumb" Color="#424242" />
  <SolidColorBrush x:Key="ScrollThumbHover" Color="#4F4F4F" />

  <!-- Diff colours: the editor's own tints, kept faint so a long added block reads as a block
       rather than a wall of green. -->
  <SolidColorBrush x:Key="DiffAddedBackground" Color="#26372B" />
  <SolidColorBrush x:Key="DiffAddedAccent" Color="#73C991" />
  <SolidColorBrush x:Key="DiffRemovedBackground" Color="#3A2626" />
  <SolidColorBrush x:Key="DiffRemovedAccent" Color="#F14C4C" />
  <SolidColorBrush x:Key="DiffHunkBackground" Color="#252526" />
  <SolidColorBrush x:Key="DiffHunkText" Color="#6796E6" />
  <SolidColorBrush x:Key="DiffGutterText" Color="#6E7681" />
  <SolidColorBrush x:Key="DiffCodeText" Color="#CCCCCC" />

  <!-- The glyph on each alert card, by kind, and the severity that overrides it. -->
  <SolidColorBrush x:Key="KindPush" Color="#3794FF" />
  <SolidColorBrush x:Key="KindPullRequest" Color="#C586C0" />
  <SolidColorBrush x:Key="KindIssue" Color="#89D185" />
  <SolidColorBrush x:Key="KindComment" Color="#9D9D9D" />
  <SolidColorBrush x:Key="KindReview" Color="#89D185" />
  <SolidColorBrush x:Key="KindRelease" Color="#CE9178" />
  <SolidColorBrush x:Key="KindBranch" Color="#3794FF" />
  <SolidColorBrush x:Key="KindWorkflow" Color="#9D9D9D" />
  <SolidColorBrush x:Key="KindStar" Color="#CCA700" />
  <SolidColorBrush x:Key="KindFork" Color="#9D9D9D" />
  <SolidColorBrush x:Key="KindMention" Color="#D7BA7D" />
  <SolidColorBrush x:Key="KindOther" Color="#9D9D9D" />
  <SolidColorBrush x:Key="SeveritySuccess" Color="#89D185" />
  <SolidColorBrush x:Key="SeverityWarning" Color="#CCA700" />
  <SolidColorBrush x:Key="SeverityError" Color="#F14C4C" />

  <Color x:Key="ShadowColor">#000000</Color>
  <system:Double xmlns:system="clr-namespace:System;assembly=System.Runtime" x:Key="ShadowOpacity">0.55</system:Double>

</ResourceDictionary>

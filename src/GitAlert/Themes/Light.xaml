<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Light palette. Same keys as Dark.xaml, so the two dictionaries are interchangeable
       at runtime without touching a single control style. -->

  <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SurfaceElevated" Color="#F6F8FA" />
  <SolidColorBrush x:Key="SurfaceHover" Color="#EFF2F5" />
  <SolidColorBrush x:Key="SurfaceSunken" Color="#F6F8FA" />

  <SolidColorBrush x:Key="Border" Color="#D8DEE4" />
  <SolidColorBrush x:Key="BorderSubtle" Color="#E8EBEF" />

  <SolidColorBrush x:Key="TextPrimary" Color="#1F2328" />
  <SolidColorBrush x:Key="TextSecondary" Color="#59636E" />
  <SolidColorBrush x:Key="TextMuted" Color="#848D97" />

  <SolidColorBrush x:Key="Accent" Color="#0969DA" />
  <SolidColorBrush x:Key="AccentHover" Color="#0A5FC2" />
  <SolidColorBrush x:Key="OnAccent" Color="#FFFFFF" />
  <SolidColorBrush x:Key="AccentSubtle" Color="#DDEBFC" />

  <SolidColorBrush x:Key="Danger" Color="#CF222E" />
  <SolidColorBrush x:Key="Success" Color="#1A7F37" />

  <SolidColorBrush x:Key="ChipBackground" Color="#F0F3F6" />
  <SolidColorBrush x:Key="ChipHover" Color="#E6EAEF" />

  <SolidColorBrush x:Key="ControlBackground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="ScrollThumb" Color="#C9D1D9" />
  <SolidColorBrush x:Key="ScrollThumbHover" Color="#AFB8C1" />

  <Color x:Key="ShadowColor">#3D4A5C</Color>
  <system:Double xmlns:system="clr-namespace:System;assembly=System.Runtime" x:Key="ShadowOpacity">0.28</system:Double>

</ResourceDictionary>

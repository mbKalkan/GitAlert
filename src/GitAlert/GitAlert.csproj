<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>GitAlert</AssemblyName>
    <RootNamespace>GitAlert</RootNamespace>
    <!-- Generated by the build from the vector artwork; conditional so a clean clone still builds. -->
    <ApplicationIcon Condition="Exists('Resources\app.ico')">Resources\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>GitAlert</AssemblyTitle>
    <Description>A Windows tray app that watches your GitHub repositories and alerts you on pushes, pull requests, issues, releases and CI runs.</Description>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- The runtime identifier belongs to `dotnet publish`, not to the project: pinning it here
         makes a plain restore and a Release build disagree about the assets file. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

</Project>

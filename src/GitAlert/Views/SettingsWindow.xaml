<Window x:Class="GitAlert.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:platform="clr-namespace:GitAlert.Platform"
        Title="GitAlert settings"
        Width="780"
        Height="580"
        MinWidth="700"
        MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

  <Window.Resources>
    <!-- Headerless tabs: the list box on the left is the navigation. -->
    <Style x:Key="HeadlessTabs" TargetType="TabControl">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <ContentPresenter ContentSource="SelectedContent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="196" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ==================== Navigation ==================== -->

    <Border Grid.Column="0"
            Background="{DynamicResource SurfaceSunken}"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="0,0,1,0">
      <DockPanel Margin="12,16,12,12">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,18">
          <Viewbox Width="22" Height="22">
            <Path Data="{x:Static platform:IconArtwork.BellGeometry}" Fill="{DynamicResource Accent}" />
          </Viewbox>
          <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="GitAlert" Style="{StaticResource TitleText}" />
            <TextBlock Text="{Binding Version, StringFormat=v{0}}" Style="{StaticResource MutedText}" />
          </StackPanel>
        </StackPanel>

        <ListBox x:Name="Navigation"
                 DockPanel.Dock="Top"
                 Background="Transparent"
                 BorderThickness="0"
                 SelectedIndex="0"
                 ItemContainerStyle="{StaticResource NavItem}">
          <ListBoxItem Content="Account" />
          <ListBoxItem Content="Repositories" />
          <ListBoxItem Content="Notifications" />
          <ListBoxItem Content="General" />
          <ListBoxItem Content="About" />
        </ListBox>

      </DockPanel>
    </Border>

    <!-- ==================== Pages ==================== -->

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TabControl Grid.Row="0"
                  Style="{StaticResource HeadlessTabs}"
                  SelectedIndex="{Binding SelectedIndex, ElementName=Navigation}">

        <!-- ========== Account ========== -->
        <TabItem>
          <ScrollViewer Style="{StaticResource SlimScrollViewer}" Padding="0">
            <StackPanel Margin="28,26,28,20">
              <TextBlock Text="GitHub account" Style="{StaticResource PageTitle}" />
              <TextBlock Style="{StaticResource PageSubtitle}"
                         Text="GitAlert talks to GitHub as you, using a personal access token. The token is encrypted with your Windows account and never leaves this machine." />

              <TextBlock Text="Personal access token" Style="{StaticResource FieldLabel}" />

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <PasswordBox x:Name="TokenBox"
                             Grid.Column="0"
                             Style="{StaticResource ModernPasswordBox}"
                             PasswordChanged="OnTokenChanged" />

                <Button Grid.Column="1"
                        Content="Validate"
                        Style="{StaticResource SecondaryButton}"
                        Margin="8,0,0,0"
                        Command="{Binding ValidateTokenCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
              </Grid>

              <StackPanel Orientation="Horizontal"
                          Margin="0,10,0,0"
                          Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
                <Ellipse Width="8" Height="8" Fill="{DynamicResource Success}" VerticalAlignment="Center" />
                <TextBlock Margin="7,0,0,0"
                           Style="{StaticResource SecondaryText}"
                           Text="{Binding SignedInAs, StringFormat=Signed in as {0}}" />
              </StackPanel>

              <Border Margin="0,22,0,0"
                      Background="{DynamicResource SurfaceElevated}"
                      BorderBrush="{DynamicResource BorderSubtle}"
                      BorderThickness="1"
                      CornerRadius="9"
                      Padding="16,14">
                <StackPanel>
                  <TextBlock Text="Which scopes do I need?" Style="{StaticResource FieldLabel}" />
                  <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,4">
                    <Run Text="•" />
                    <Run Text="repo" FontWeight="SemiBold" />
                    <Run Text=" - only if you want to watch private repositories." />
                  </TextBlock>
                  <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,4">
                    <Run Text="•" />
                    <Run Text="notifications" FontWeight="SemiBold" />
                    <Run Text=" - only if you want mentions and review requests from your inbox." />
                  </TextBlock>
                  <TextBlock Style="{StaticResource MutedText}"
                             TextWrapping="Wrap"
                             Margin="0,4,0,12"
                             Text="Public repositories need no scopes at all." />
                  <Button Content="Create a token on GitHub"
                          Style="{StaticResource SecondaryButton}"
                          HorizontalAlignment="Left"
                          Command="{Binding CreateTokenCommand}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ========== Repositories ========== -->
        <TabItem>
          <Grid Margin="28,26,28,20">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
              <TextBlock Text="Watched repositories" Style="{StaticResource PageTitle}" />
              <TextBlock Style="{StaticResource PageSubtitle}"
                         Text="Paste a repository link from your browser. GitAlert checks that your token can see it before adding it to the list." />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,16">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <Grid Grid.Column="0">
                <TextBox x:Name="RepoInput"
                         Style="{StaticResource ModernTextBox}"
                         Text="{Binding NewRepositoryInput, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnRepoInputKeyDown" />
                <TextBlock Text="https://github.com/owner/repository"
                           Style="{StaticResource MutedText}"
                           Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Visibility="{Binding NewRepositoryInput, Converter={StaticResource EmptyStringToVisibility}}" />
              </Grid>

              <Button Grid.Column="1"
                      Content="Add"
                      Style="{StaticResource PrimaryButton}"
                      Margin="8,0,0,0"
                      Command="{Binding AddRepositoryCommand}" />
            </Grid>

            <Border Grid.Row="2"
                    Background="{DynamicResource SurfaceSunken}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="9">
              <Grid>
                <ScrollViewer Style="{StaticResource SlimScrollViewer}" Margin="6,6,4,6">
                  <ItemsControl ItemsSource="{Binding Repositories}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="Transparent" CornerRadius="7" Padding="10,8" Margin="0,1">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <CheckBox Grid.Column="0"
                                      Style="{StaticResource ModernCheckBox}"
                                      Margin="0"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsEnabled}"
                                      ToolTip="Check this repository during each poll" />

                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding FullName}" FontSize="13" FontWeight="Medium" />
                              <TextBlock Text="{Binding Url}" Style="{StaticResource MutedText}" />
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Background="{DynamicResource ChipBackground}"
                                    CornerRadius="10"
                                    Padding="8,3"
                                    VerticalAlignment="Center"
                                    Margin="0,0,6,0"
                                    Visibility="{Binding IsPrivate, Converter={StaticResource BoolToVisibility}}">
                              <TextBlock Text="Private" Style="{StaticResource MutedText}" />
                            </Border>

                            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                              <Button Style="{StaticResource GhostButton}"
                                      Content="Open"
                                      Command="{Binding DataContext.OpenRepositoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}" />
                              <Button Style="{StaticResource GhostButton}"
                                      Content="Remove"
                                      Command="{Binding DataContext.RemoveRepositoryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                      CommandParameter="{Binding}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="No repositories yet. Paste a link above to start watching one."
                           Style="{StaticResource MutedText}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="{Binding Repositories.Count, Converter={StaticResource EmptyCountToVisibility}}" />
              </Grid>
            </Border>
          </Grid>
        </TabItem>

        <!-- ========== Notifications ========== -->
        <TabItem>
          <ScrollViewer Style="{StaticResource SlimScrollViewer}">
            <StackPanel Margin="28,26,28,20">
              <TextBlock Text="What to tell me about" Style="{StaticResource PageTitle}" />
              <TextBlock Style="{StaticResource PageSubtitle}"
                         Text="Switch off anything you would rather not hear about. Muted kinds are neither shown as a toast nor added to the list." />

              <ItemsControl ItemsSource="{Binding Kinds}" Margin="0,0,0,10">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Style="{StaticResource ModernCheckBox}"
                              Width="220"
                              Content="{Binding Label}"
                              IsChecked="{Binding IsEnabled}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,8,0,18" />

              <TextBlock Text="SOURCES" Style="{StaticResource SectionHeader}" />

              <CheckBox Style="{StaticResource ModernCheckBox}"
                        IsChecked="{Binding IncludeInbox}"
                        Content="Include my GitHub inbox (mentions, review requests, assignments)" />

              <CheckBox Style="{StaticResource ModernCheckBox}"
                        IsChecked="{Binding WatchWorkflowRuns}"
                        Content="Watch GitHub Actions runs" />

              <CheckBox Style="{StaticResource ModernCheckBox}"
                        Margin="26,0,0,10"
                        IsEnabled="{Binding WatchWorkflowRuns}"
                        IsChecked="{Binding OnlyFailedWorkflowRuns}"
                        Content="Only tell me when a run fails" />

              <CheckBox Style="{StaticResource ModernCheckBox}"
                        IsChecked="{Binding IgnoreOwnActivity}"
                        Content="Ignore activity I caused myself" />

              <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,8,0,18" />

              <TextBlock Text="DELIVERY" Style="{StaticResource SectionHeader}" />

              <CheckBox Style="{StaticResource ModernCheckBox}"
                        IsChecked="{Binding ShowToasts}"
                        Content="Show a desktop notification for new alerts" />

              <CheckBox Style="{StaticResource ModernCheckBox}"
                        Margin="26,0,0,10"
                        IsEnabled="{Binding ShowToasts}"
                        IsChecked="{Binding PlaySound}"
                        Content="Play the notification sound" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ========== General ========== -->
        <TabItem>
          <ScrollViewer Style="{StaticResource SlimScrollViewer}">
            <StackPanel Margin="28,26,28,20">
              <TextBlock Text="General" Style="{StaticResource PageTitle}" />
              <TextBlock Style="{StaticResource PageSubtitle}"
                         Text="How often GitAlert checks, how it looks, and how much history it keeps." />

              <TextBlock Text="Check for updates" Style="{StaticResource FieldLabel}" />
              <ComboBox Style="{StaticResource ModernComboBox}"
                        Width="260"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding PollIntervalOptions}"
                        SelectedItem="{Binding PollIntervalMinutes}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource MinutesToText}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Style="{StaticResource MutedText}"
                         Margin="0,6,0,18"
                         TextWrapping="Wrap"
                         Text="Unchanged data costs nothing against your API budget, so a short interval is usually fine." />

              <TextBlock Text="Appearance" Style="{StaticResource FieldLabel}" />
              <ComboBox Style="{StaticResource ModernComboBox}"
                        Width="260"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,18"
                        ItemsSource="{Binding ThemeOptions}"
                        SelectedItem="{Binding Theme}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource ThemeToText}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Text="History" Style="{StaticResource FieldLabel}" />
              <ComboBox Style="{StaticResource ModernComboBox}"
                        Width="260"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,18"
                        ItemsSource="{Binding HistoryOptions}"
                        SelectedItem="{Binding MaxHistory}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource HistoryToText}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <CheckBox Style="{StaticResource ModernCheckBox}"
                        Margin="0,0,0,20"
                        IsChecked="{Binding StartWithWindows}"
                        Content="Start GitAlert when I sign in to Windows" />

              <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,0,0,18" />

              <TextBlock Text="MAINTENANCE" Style="{StaticResource SectionHeader}" />

              <StackPanel Orientation="Horizontal">
                <Button Content="Clear alert history"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Command="{Binding ClearHistoryCommand}" />
                <Button Content="Reset sync state"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Command="{Binding ResetStateCommand}" />
                <Button Content="Open data folder"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenDataFolderCommand}" />
              </StackPanel>

              <TextBlock Style="{StaticResource MutedText}"
                         Margin="0,10,0,0"
                         TextWrapping="Wrap"
                         Text="{Binding DataDirectory}" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ========== About ========== -->
        <TabItem>
          <StackPanel Margin="28,26,28,20">
            <TextBlock Text="About GitAlert" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="A small Windows tray app that keeps an eye on the repositories you care about." />

            <Border Background="{DynamicResource SurfaceElevated}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="18,16">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                  <Viewbox Width="34" Height="34">
                    <Path Data="{x:Static platform:IconArtwork.BellGeometry}" Fill="{DynamicResource Accent}" />
                  </Viewbox>
                  <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="GitAlert" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Version, StringFormat=Version {0}}" Style="{StaticResource MutedText}" />
                  </StackPanel>
                </StackPanel>

                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Built because tabbing back to GitHub to find out whether anything happened is a poor use of a working day." />
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           Text="Your token stays on this machine, encrypted with your Windows account. GitAlert talks to api.github.com and nowhere else." />
              </StackPanel>
            </Border>
          </StackPanel>
        </TabItem>

      </TabControl>

      <!-- ==================== Footer ==================== -->

      <Border Grid.Row="1"
              Background="{DynamicResource SurfaceSunken}"
              BorderBrush="{DynamicResource BorderSubtle}"
              BorderThickness="0,1,0,0"
              Padding="20,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0"
                     Text="{Binding Message}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Margin="0,0,16,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsMessageError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}" />
            <Button Content="Save"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>

<Window x:Class="GitAlert.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:platform="clr-namespace:GitAlert.Platform"
        xmlns:views="clr-namespace:GitAlert.Views"
        Title="GitAlert settings"
        Width="820"
        Height="640"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

  <Window.Resources>
    <!-- Headerless tabs: the list box on the left is the navigation. -->
    <Style x:Key="HeadlessTabs" TargetType="TabControl">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <ContentPresenter ContentSource="SelectedContent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="PageTitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,18" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- The note under an account card, red when it reports a problem. -->
    <Style x:Key="InlineMessage" TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,8,0,0" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsMessageError}" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource Danger}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!-- One repository row inside an account card. The nearest ItemsControl ancestor is the
         repository list, whose DataContext is the owning account. -->
    <DataTemplate x:Key="RepositoryRow">
      <Border Background="Transparent" CornerRadius="6" Padding="8,6" Margin="0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <CheckBox Grid.Column="0"
                    Style="{StaticResource ModernCheckBox}"
                    Margin="0"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsEnabled}"
                    ToolTip="Check this repository during each poll" />

          <TextBlock Grid.Column="1"
                     Text="{Binding FullName}"
                     FontSize="12.5"
                     Margin="10,0,0,0"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />

          <Border Grid.Column="2"
                  Background="{DynamicResource ChipBackground}"
                  CornerRadius="9"
                  Padding="7,2"
                  Margin="0,0,6,0"
                  VerticalAlignment="Center"
                  Visibility="{Binding IsPrivate, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="Private" Style="{StaticResource MutedText}" FontSize="10.5" />
          </Border>

          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource GhostButton}"
                    Content="Open"
                    Padding="7,3"
                    Command="{Binding DataContext.OpenRepositoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}" />
            <Button Style="{StaticResource GhostButton}"
                    Content="Remove"
                    Padding="7,3"
                    Command="{Binding DataContext.RemoveRepositoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                    CommandParameter="{Binding}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- One GitHub account, with the repositories watched under it. -->
    <DataTemplate x:Key="AccountCard">
      <Border Background="{DynamicResource SurfaceElevated}"
              BorderBrush="{DynamicResource BorderSubtle}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="16,14"
              Margin="0,0,0,12">
        <StackPanel>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="30"
                    Height="30"
                    CornerRadius="15"
                    Background="{DynamicResource AccentSubtle}"
                    VerticalAlignment="Center">
              <Path Data="M8,2 A3.2,3.2 0 1 1 8,8.4 A3.2,3.2 0 1 1 8,2 Z M2.4,14.4 C2.4,11.3 4.9,9.6 8,9.6 C11.1,9.6 13.6,11.3 13.6,14.4 Z"
                    Fill="{DynamicResource Accent}"
                    Width="15"
                    Height="15"
                    Stretch="Uniform"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="{Binding RepositorySummary}" Style="{StaticResource MutedText}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <CheckBox Style="{StaticResource ModernCheckBox}"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        IsChecked="{Binding IsEnabled}"
                        Content="Active"
                        ToolTip="Uncheck to pause this account without removing it" />
              <Button Style="{StaticResource GhostButton}"
                      Content="Replace token"
                      Command="{Binding BeginReplaceTokenCommand}" />
              <Button Style="{StaticResource GhostButton}"
                      Content="Remove"
                      Command="{Binding RemoveCommand}" />
            </StackPanel>
          </Grid>

          <!-- Shown when the stored token could not be decrypted, which needs a new one. -->
          <Border Background="{DynamicResource ChipBackground}"
                  CornerRadius="7"
                  Padding="10,7"
                  Margin="0,12,0,0">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding HasStoredToken}" Value="False" />
                      <Condition Binding="{Binding IsReplacingToken}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Style="{StaticResource SecondaryText}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Danger}"
                       Text="No usable token for this account. Choose Replace token to sign in again." />
          </Border>

          <!-- Replace-token panel. -->
          <Grid Margin="0,12,0,0" Visibility="{Binding IsReplacingToken, Converter={StaticResource BoolToVisibility}}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <PasswordBox Grid.Column="0"
                         Style="{StaticResource ModernPasswordBox}"
                         views:PasswordBoxBinder.BoundPassword="{Binding PendingToken, Mode=TwoWay}">
              <PasswordBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ApplyTokenCommand}" />
              </PasswordBox.InputBindings>
            </PasswordBox>

            <Button Grid.Column="1"
                    Content="Save token"
                    Style="{StaticResource PrimaryButton}"
                    Margin="8,0,0,0"
                    Command="{Binding ApplyTokenCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

            <Button Grid.Column="2"
                    Content="Cancel"
                    Style="{StaticResource GhostButton}"
                    Margin="4,0,0,0"
                    Command="{Binding CancelReplaceTokenCommand}" />
          </Grid>

          <CheckBox Style="{StaticResource ModernCheckBox}"
                    Margin="0,14,0,4"
                    IsChecked="{Binding IncludeInbox}"
                    Content="Watch this account's inbox (mentions, review requests, assignments)" />

          <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,8,0,12" />

          <TextBlock Text="REPOSITORIES" Style="{StaticResource SectionHeader}" />

          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
              <TextBox Style="{StaticResource ModernTextBox}"
                       Text="{Binding NewRepositoryInput, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings>
                  <KeyBinding Key="Enter" Command="{Binding AddRepositoryCommand}" />
                </TextBox.InputBindings>
              </TextBox>
              <TextBlock Text="https://github.com/owner/repository"
                         Style="{StaticResource MutedText}"
                         Margin="12,0,0,0"
                         VerticalAlignment="Center"
                         IsHitTestVisible="False"
                         Visibility="{Binding NewRepositoryInput, Converter={StaticResource EmptyStringToVisibility}}" />
            </Grid>

            <Button Grid.Column="1"
                    Content="Add repository"
                    Style="{StaticResource SecondaryButton}"
                    Margin="8,0,0,0"
                    Command="{Binding AddRepositoryCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />
          </Grid>

          <ItemsControl ItemsSource="{Binding Repositories}" ItemTemplate="{StaticResource RepositoryRow}" />

          <TextBlock Text="Nothing watched under this account yet."
                     Style="{StaticResource MutedText}"
                     Margin="8,4,0,0"
                     Visibility="{Binding Repositories.Count, Converter={StaticResource EmptyCountToVisibility}}" />

          <TextBlock Style="{StaticResource InlineMessage}"
                     Text="{Binding Message}"
                     Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />

        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="196" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ==================== Navigation ==================== -->

    <Border Grid.Column="0"
            Background="{DynamicResource SurfaceSunken}"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="0,0,1,0">
      <DockPanel Margin="12,16,12,12">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,18">
          <Viewbox Width="22" Height="22">
            <Path Data="{x:Static platform:IconArtwork.BellGeometry}" Fill="{DynamicResource Accent}" />
          </Viewbox>
          <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="GitAlert" Style="{StaticResource TitleText}" />
            <TextBlock Text="{Binding Version, StringFormat=v{0}}" Style="{StaticResource MutedText}" />
          </StackPanel>
        </StackPanel>

        <ListBox x:Name="Navigation"
                 DockPanel.Dock="Top"
                 Background="Transparent"
                 BorderThickness="0"
                 SelectedIndex="0"
                 ItemContainerStyle="{StaticResource NavItem}">
          <ListBoxItem Content="Accounts" />
          <ListBoxItem Content="Notifications" />
          <ListBoxItem Content="General" />
          <ListBoxItem Content="About" />
        </ListBox>

      </DockPanel>
    </Border>

    <!-- ==================== Pages ==================== -->

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TabControl Grid.Row="0"
                  Style="{StaticResource HeadlessTabs}"
                  SelectedIndex="{Binding SelectedIndex, ElementName=Navigation}">

        <!-- ========== Accounts ========== -->
        <TabItem>
          <Grid Margin="28,26,28,16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Margin="0,0,16,0">
                <TextBlock Text="GitHub accounts" Style="{StaticResource PageTitle}" />
                <TextBlock Style="{StaticResource PageSubtitle}"
                           Text="Add an account for each token you have, then add repositories under the account whose token can see them. A work account and a personal account sit side by side." />
              </StackPanel>

              <Button Grid.Column="1"
                      Content="Add account"
                      Style="{StaticResource PrimaryButton}"
                      VerticalAlignment="Top"
                      Command="{Binding BeginAddAccountCommand}"
                      Visibility="{Binding IsAddingAccount, Converter={StaticResource InverseBoolToVisibility}}" />
            </Grid>

            <!-- Add-account panel. -->
            <Border Grid.Row="1"
                    Background="{DynamicResource SurfaceElevated}"
                    BorderBrush="{DynamicResource Accent}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16,14"
                    Margin="0,0,0,14"
                    Visibility="{Binding IsAddingAccount, Converter={StaticResource BoolToVisibility}}">
              <StackPanel>
                <TextBlock Text="Personal access token" Style="{StaticResource FieldLabel}" />
                <TextBlock Style="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"
                           Text="Public repositories need no scopes. Add repo for private repositories, and notifications for mentions and review requests. The token is encrypted with your Windows account." />

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <PasswordBox Grid.Column="0"
                               Style="{StaticResource ModernPasswordBox}"
                               views:PasswordBoxBinder.BoundPassword="{Binding NewAccountToken, Mode=TwoWay}">
                    <PasswordBox.InputBindings>
                      <KeyBinding Key="Enter" Command="{Binding AddAccountCommand}" />
                    </PasswordBox.InputBindings>
                  </PasswordBox>

                  <Button Grid.Column="1"
                          Content="Add"
                          Style="{StaticResource PrimaryButton}"
                          Margin="8,0,0,0"
                          Command="{Binding AddAccountCommand}"
                          IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                  <Button Grid.Column="2"
                          Content="Cancel"
                          Style="{StaticResource GhostButton}"
                          Margin="4,0,0,0"
                          Command="{Binding CancelAddAccountCommand}" />
                </Grid>

                <Button Content="Create a token on GitHub"
                        Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Left"
                        Margin="-9,8,0,0"
                        Command="{Binding CreateTokenCommand}" />
              </StackPanel>
            </Border>

            <Grid Grid.Row="2">
              <ScrollViewer Style="{StaticResource SlimScrollViewer}" Margin="0,0,4,0">
                <ItemsControl ItemsSource="{Binding Accounts}" ItemTemplate="{StaticResource AccountCard}" />
              </ScrollViewer>

              <StackPanel VerticalAlignment="Center"
                          HorizontalAlignment="Center"
                          Visibility="{Binding HasNoAccounts, Converter={StaticResource BoolToVisibility}}">
                <Viewbox Width="34" Height="34" Opacity="0.25" HorizontalAlignment="Center">
                  <Path Data="{x:Static platform:IconArtwork.BellGeometry}" Fill="{DynamicResource TextMuted}" />
                </Viewbox>
                <TextBlock Text="No accounts yet. Add one to get started."
                           Style="{StaticResource SecondaryText}"
                           Margin="0,12,0,0"
                           TextAlignment="Center" />
              </StackPanel>
            </Grid>
          </Grid>
        </TabItem>

        <!-- ========== Notifications ========== -->
        <TabItem>
          <ScrollViewer Style="{StaticResource SlimScrollViewer}">
            <StackPanel Margin="28,26,28,20">
              <TextBlock Text="What to tell me about" Style="{StaticResource PageTitle}" />
              <TextBlock Style="{StaticResource PageSubtitle}"
                         Text="Switch off anything you would rather not hear about. Muted kinds are neither shown as a toast nor added to the list. These apply to every account." />

              <ItemsControl ItemsSource="{Binding Kinds}" Margin="0,0,0,10">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <CheckBox Style="{StaticResource ModernCheckBox}"
                              Width="230"
                              Content="{Binding Label}"
                              IsChecked="{Binding IsEnabled}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,8,0,18" />

              <TextBlock Text="SOURCES" Style="{StaticResource SectionHeader}" />

              <TextBlock Style="{StaticResource MutedText}"
                         TextWrapping="Wrap"
                         Margin="0,0,0,12"
                         Text="Each account decides for itself whether its inbox is watched; that switch lives on the account card." />

              <CheckBox Style="{StaticResource ModernCheckBox}"
                        IsChecked="{Binding WatchWorkflowRuns}"
                        Content="Watch GitHub Actions runs" />

              <CheckBox Style="{StaticResource ModernCheckBox}"
                        Margin="26,0,0,10"
                        IsEnabled="{Binding WatchWorkflowRuns}"
                        IsChecked="{Binding OnlyFailedWorkflowRuns}"
                        Content="Only tell me when a run fails" />

              <CheckBox Style="{StaticResource ModernCheckBox}"
                        IsChecked="{Binding IgnoreOwnActivity}"
                        Content="Ignore activity I caused myself" />

              <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,8,0,18" />

              <TextBlock Text="DELIVERY" Style="{StaticResource SectionHeader}" />

              <CheckBox Style="{StaticResource ModernCheckBox}"
                        IsChecked="{Binding ShowToasts}"
                        Content="Show a desktop notification for new alerts" />

              <CheckBox Style="{StaticResource ModernCheckBox}"
                        Margin="26,0,0,10"
                        IsEnabled="{Binding ShowToasts}"
                        IsChecked="{Binding PlaySound}"
                        Content="Play the notification sound" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ========== General ========== -->
        <TabItem>
          <ScrollViewer Style="{StaticResource SlimScrollViewer}">
            <StackPanel Margin="28,26,28,20">
              <TextBlock Text="General" Style="{StaticResource PageTitle}" />
              <TextBlock Style="{StaticResource PageSubtitle}"
                         Text="How often GitAlert checks, how it looks, and how much history it keeps." />

              <TextBlock Text="Check for updates" Style="{StaticResource FieldLabel}" />
              <ComboBox Style="{StaticResource ModernComboBox}"
                        Width="260"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding PollIntervalOptions}"
                        SelectedItem="{Binding PollIntervalMinutes}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource MinutesToText}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Style="{StaticResource MutedText}"
                         Margin="0,6,0,18"
                         TextWrapping="Wrap"
                         Text="Unchanged data costs nothing against your API budget, so a short interval is usually fine." />

              <TextBlock Text="Appearance" Style="{StaticResource FieldLabel}" />
              <ComboBox Style="{StaticResource ModernComboBox}"
                        Width="260"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,18"
                        ItemsSource="{Binding ThemeOptions}"
                        SelectedItem="{Binding Theme}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource ThemeToText}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <TextBlock Text="History" Style="{StaticResource FieldLabel}" />
              <ComboBox Style="{StaticResource ModernComboBox}"
                        Width="260"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,18"
                        ItemsSource="{Binding HistoryOptions}"
                        SelectedItem="{Binding MaxHistory}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource HistoryToText}}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <CheckBox Style="{StaticResource ModernCheckBox}"
                        Margin="0,0,0,20"
                        IsChecked="{Binding StartWithWindows}"
                        Content="Start GitAlert when I sign in to Windows" />

              <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,0,0,18" />

              <TextBlock Text="MAINTENANCE" Style="{StaticResource SectionHeader}" />

              <StackPanel Orientation="Horizontal">
                <Button Content="Clear alert history"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Command="{Binding ClearHistoryCommand}" />
                <Button Content="Reset sync state"
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Command="{Binding ResetStateCommand}" />
                <Button Content="Open data folder"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding OpenDataFolderCommand}" />
              </StackPanel>

              <TextBlock Style="{StaticResource MutedText}"
                         Margin="0,10,0,0"
                         TextWrapping="Wrap"
                         Text="{Binding DataDirectory}" />
            </StackPanel>
          </ScrollViewer>
        </TabItem>

        <!-- ========== About ========== -->
        <TabItem>
          <StackPanel Margin="28,26,28,20">
            <TextBlock Text="About GitAlert" Style="{StaticResource PageTitle}" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="A small Windows tray app that keeps an eye on the repositories you care about." />

            <Border Background="{DynamicResource SurfaceElevated}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="18,16">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                  <Viewbox Width="34" Height="34">
                    <Path Data="{x:Static platform:IconArtwork.BellGeometry}" Fill="{DynamicResource Accent}" />
                  </Viewbox>
                  <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="GitAlert" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Version, StringFormat=Version {0}}" Style="{StaticResource MutedText}" />
                  </StackPanel>
                </StackPanel>

                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,0,0,6"
                           Text="Built because tabbing back to GitHub to find out whether anything happened is a poor use of a working day." />
                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           Text="Your tokens stay on this machine, encrypted with your Windows account. GitAlert talks to api.github.com and nowhere else." />
              </StackPanel>
            </Border>
          </StackPanel>
        </TabItem>

      </TabControl>

      <!-- ==================== Footer ==================== -->

      <Border Grid.Row="1"
              Background="{DynamicResource SurfaceSunken}"
              BorderBrush="{DynamicResource BorderSubtle}"
              BorderThickness="0,1,0,0"
              Padding="20,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0"
                     Text="{Binding Message}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Margin="0,0,16,0">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsMessageError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>

          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Content="Cancel"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}" />
            <Button Content="Save"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>

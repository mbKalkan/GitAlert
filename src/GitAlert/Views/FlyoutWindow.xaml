<Window x:Class="GitAlert.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GitAlert.ViewModels"
        xmlns:core="clr-namespace:GitAlert.Core"
        xmlns:platform="clr-namespace:GitAlert.Platform"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="GitAlert"
        Width="1020"
        Height="660"
        MinWidth="640"
        MinHeight="420"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource Surface}"
        Foreground="{DynamicResource TextPrimary}"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

  <!-- A real resizable window rather than a transparent popup: the caption is drawn by the
       header below, but the frame, the resize borders and Aero snap are the system's. -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="52"
                        ResizeBorderThickness="6"
                        GlassFrameThickness="0"
                        CornerRadius="0"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>

    <!-- The whole alert row is a button, so it is keyboard reachable and gets a real hover state. -->
    <Style x:Key="AlertCard" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="2,0,0,0"
                    CornerRadius="9"
                    Padding="9,7,10,7"
                    Margin="0,1">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceHover}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceHover}" />
              </Trigger>

              <!-- The selected row is the one the detail pane is showing, so it stays marked
                   even while the mouse is somewhere else entirely. -->
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSubtle}" />
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="AlertTemplate" DataType="{x:Type vm:AlertViewModel}">
      <StackPanel>
        <Button Style="{StaticResource AlertCard}"
                Command="{Binding DataContext.SelectAlertCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                CommandParameter="{Binding}"
                ToolTip="{Binding Tooltip}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Kind badge: the glyph in its accent colour on a tile tinted with the same hue. -->
            <Border Grid.Column="0"
                    Width="30"
                    Height="30"
                    CornerRadius="8"
                    Background="{Binding Accent}"
                    Opacity="0.16"
                    VerticalAlignment="Top" />

            <Path Grid.Column="0"
                  Data="{Binding Glyph}"
                  Fill="{Binding Accent}"
                  Width="16"
                  Height="16"
                  Stretch="Uniform"
                  Margin="0,7,0,0"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top" />

            <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
              <TextBlock x:Name="TitleLine"
                         Text="{Binding PrimaryText}"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimary}"
                         TextTrimming="CharacterEllipsis" />

              <TextBlock Text="{Binding SecondaryText}"
                         FontSize="12"
                         Margin="0,2,0,0"
                         Foreground="{DynamicResource TextSecondary}"
                         TextTrimming="CharacterEllipsis"
                         Visibility="{Binding HasSecondaryText, Converter={StaticResource BoolToVisibility}}" />

              <TextBlock Text="{Binding RowMeta}"
                         FontSize="11.5"
                         Margin="0,2,0,0"
                         Foreground="{DynamicResource TextMuted}"
                         TextTrimming="CharacterEllipsis"
                         Visibility="{Binding RowMeta, Converter={StaticResource StringToVisibility}}" />
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,1,0,0">
              <TextBlock Text="{Binding Age}"
                         FontSize="11.5"
                         Foreground="{DynamicResource TextMuted}"
                         HorizontalAlignment="Right" />

              <Ellipse x:Name="UnreadDot"
                       Width="7"
                       Height="7"
                       Margin="0,6,1,0"
                       Fill="{DynamicResource Accent}"
                       HorizontalAlignment="Right" />
            </StackPanel>
          </Grid>
        </Button>

        <!-- What the open alert unfolds: one line with the count and the two actions, then the
             files it touched. They belong to the detail view model, which only ever holds the
             selected alert's, so every card may bind to it and only the open one shows it. -->
        <StackPanel x:Name="Changes"
                    Visibility="Collapsed"
                    Margin="36,0,4,6"
                    DataContext="{Binding DataContext.Detail, RelativeSource={RelativeSource AncestorType=Window}}">
          <Grid Margin="10,3,2,3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding Caption}"
                       Style="{StaticResource MutedText}"
                       Margin="0,0,8,0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />

            <Button Grid.Column="1"
                    Content="Reload"
                    Style="{StaticResource LinkButton}"
                    Command="{Binding ReloadCommand}"
                    ToolTip="Fetch the changed files again"
                    Visibility="{Binding CanReload, Converter={StaticResource BoolToVisibility}}" />

            <Button Grid.Column="2"
                    Content="Open on GitHub"
                    Style="{StaticResource LinkButton}"
                    Margin="4,0,0,0"
                    Command="{Binding OpenOnGitHubCommand}" />
          </Grid>

          <!-- Bound only while open, like a project's rows, so a folded card keeps no row containers.
               The row template is defined further down with the rest of the diff, hence dynamic. -->
          <ItemsControl x:Name="FileRows" ItemTemplate="{DynamicResource FileRowTemplate}" />

          <!-- A merge across hundreds of files would otherwise push every other project off the
               bottom of the list. -->
          <Button Content="{Binding ShowAllFilesLabel}"
                  Style="{StaticResource LinkButton}"
                  HorizontalAlignment="Left"
                  Margin="6,2,0,0"
                  Command="{Binding ShowAllFilesCommand}"
                  Visibility="{Binding HasHiddenFiles, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
      </StackPanel>

      <DataTemplate.Triggers>
        <!-- Read alerts lose the dot and the emphasis, but stay in the list. -->
        <DataTrigger Binding="{Binding IsRead}" Value="True">
          <Setter TargetName="UnreadDot" Property="Visibility" Value="Hidden" />
          <Setter TargetName="TitleLine" Property="FontWeight" Value="Normal" />
          <Setter TargetName="TitleLine" Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </DataTrigger>

        <!-- The open card: its changes unfold under it, fading in rather than snapping. -->
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter TargetName="Changes" Property="Visibility" Value="Visible" />
          <Setter TargetName="FileRows" Property="ItemsSource" Value="{Binding Files}" />
          <DataTrigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="Changes"
                                 Storyboard.TargetProperty="Opacity"
                                 From="0"
                                 To="1"
                                 Duration="0:0:0.15" />
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The small buttons on a project header: the tick that reads it and the two arrows that
         order it. Only visible on hover. -->
    <Style x:Key="HeaderToolButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Width" Value="20" />
      <Setter Property="Height" Value="18" />
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="4">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceHover}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.25" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Alerts / History. Selection comes in through Tag so the buttons stay plain buttons. -->
    <Style x:Key="ModeChip" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="11" Padding="14,4">
              <TextBlock x:Name="Text"
                         Text="{TemplateBinding Content}"
                         FontSize="11.5"
                         FontWeight="Medium"
                         Foreground="{DynamicResource TextSecondary}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ChipHover}" />
                <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource TextPrimary}" />
              </Trigger>
              <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Accent}" />
                <Setter TargetName="Text" Property="Foreground" Value="{DynamicResource OnAccent}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The repository header above a group of alerts. Clicking it folds the group away. -->
    <Style x:Key="GroupHeaderButton" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="6,5" Margin="0,4,0,1">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceHover}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceHover}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The line that says where a dragged project will land. -->
    <Style x:Key="DropLine" TargetType="Border">
      <Setter Property="Height" Value="2" />
      <Setter Property="CornerRadius" Value="1" />
      <Setter Property="Margin" Value="6,2,8,2" />
      <Setter Property="Background" Value="{DynamicResource Accent}" />
      <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <DataTemplate x:Key="ProjectGroupTemplate" DataType="{x:Type vm:ProjectGroupViewModel}">
      <StackPanel>
        <Border x:Name="DropAbove" Style="{StaticResource DropLine}" />

        <!-- Pressing and moving the header drags the project; a plain click still folds it. -->
        <Button x:Name="Header"
                Style="{StaticResource GroupHeaderButton}"
                Command="{Binding ToggleCommand}"
                ToolTip="{Binding Repository}"
                PreviewMouseLeftButtonDown="OnGroupHeaderMouseDown"
                PreviewMouseMove="OnGroupHeaderMouseMove">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Path x:Name="Chevron"
                  Grid.Column="0"
                  Data="M4,2.5 L8.5,7 L4,11.5"
                  Stroke="{DynamicResource TextMuted}"
                  StrokeThickness="1.5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  Width="11"
                  Height="12"
                  Stretch="Uniform"
                  VerticalAlignment="Center"
                  RenderTransformOrigin="0.5,0.5" />

            <TextBlock Grid.Column="1"
                       Margin="7,0,8,0"
                       VerticalAlignment="Center"
                       FontSize="12.5"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"><Run Text="{Binding OwnerPrefix, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" FontWeight="Normal" /><Run Text="{Binding Name, Mode=OneWay}" Foreground="{DynamicResource TextPrimary}" /></TextBlock>

            <StackPanel x:Name="HeaderTools"
                        Grid.Column="2"
                        Orientation="Horizontal"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Opacity="0">
              <!-- One tick reads the whole project, so a busy repository need not be read row by row. -->
              <Button Style="{StaticResource HeaderToolButton}"
                      Command="{Binding MarkReadCommand}"
                      IsEnabled="{Binding HasUnread}"
                      Margin="0,0,4,0"
                      ToolTip="Mark everything in this project read">
                <Path Data="M2,7.2 L5.6,10.6 L11.6,3.6"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round" />
              </Button>
              <Button Style="{StaticResource HeaderToolButton}"
                      Command="{Binding MoveUpCommand}"
                      IsEnabled="{Binding CanMoveUp}"
                      ToolTip="Move this project up">
                <Path Data="M2,7 L6.5,2.5 L11,7"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
              </Button>
              <Button Style="{StaticResource HeaderToolButton}"
                      Command="{Binding MoveDownCommand}"
                      IsEnabled="{Binding CanMoveDown}"
                      ToolTip="Move this project down">
                <Path Data="M2,2.5 L6.5,7 L11,2.5"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.6"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round" />
              </Button>
            </StackPanel>

            <Border x:Name="CountBadge"
                    Grid.Column="3"
                    MinWidth="16"
                    Height="16"
                    CornerRadius="8"
                    VerticalAlignment="Center"
                    Background="{DynamicResource ChipBackground}"
                    Visibility="{Binding ShowCount, Converter={StaticResource BoolToVisibility}}">
              <TextBlock x:Name="CountText"
                         Text="{Binding CountText}"
                         FontSize="10"
                         FontWeight="SemiBold"
                         Margin="5,0"
                         Foreground="{DynamicResource TextMuted}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
          </Grid>
        </Button>

        <!-- Everything below only exists while the section is open. -->
        <StackPanel x:Name="Body" Visibility="Collapsed" Margin="0,0,0,2">
          <ItemsControl x:Name="Rows" ItemTemplate="{StaticResource AlertTemplate}" />

          <TextBlock Text="Reading&#8230;"
                     Style="{StaticResource MutedText}"
                     Margin="26,4,0,4"
                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

          <TextBlock Text="{Binding Message}"
                     Style="{StaticResource MutedText}"
                     Margin="26,4,10,4"
                     TextWrapping="Wrap"
                     Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}" />

          <Button Content="{Binding LoadMoreLabel}"
                  Style="{StaticResource GhostButton}"
                  HorizontalAlignment="Left"
                  Margin="22,2,0,4"
                  Command="{Binding LoadMoreCommand}"
                  Visibility="{Binding CanLoadMore, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <Border x:Name="DropBelow" Style="{StaticResource DropLine}" />
      </StackPanel>

      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding DropMarker}" Value="Above">
          <Setter TargetName="DropAbove" Property="Visibility" Value="Visible" />
        </DataTrigger>

        <DataTrigger Binding="{Binding DropMarker}" Value="Below">
          <Setter TargetName="DropBelow" Property="Visibility" Value="Visible" />
        </DataTrigger>

        <DataTrigger Binding="{Binding IsBeingDragged}" Value="True">
          <Setter TargetName="Header" Property="Opacity" Value="0.45" />
        </DataTrigger>

        <!-- The header's own hover, by name. Looking for the nearest StackPanel found the
             panel that hosts every project, so the buttons lit up on all of them at once
             whenever the mouse was anywhere over the list. -->
        <DataTrigger Binding="{Binding IsMouseOver, ElementName=Header}" Value="True">
          <Setter TargetName="HeaderTools" Property="Opacity" Value="1" />
        </DataTrigger>

        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
          <Setter TargetName="Body" Property="Visibility" Value="Visible" />
          <Setter TargetName="Rows" Property="ItemsSource" Value="{Binding Items}" />
          <Setter TargetName="Chevron" Property="RenderTransform">
            <Setter.Value>
              <RotateTransform Angle="90" />
            </Setter.Value>
          </Setter>
        </DataTrigger>

        <!-- A project with unread alerts wears the accent, so a folded one still says so. -->
        <DataTrigger Binding="{Binding HasUnread}" Value="True">
          <Setter TargetName="CountBadge" Property="Background" Value="{DynamicResource Accent}" />
          <Setter TargetName="CountText" Property="Foreground" Value="{DynamicResource OnAccent}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ==================== Diff ==================== -->

    <!-- A row in the change list. Same idea as the alert card: the whole row is the button. -->
    <Style x:Key="FileRow" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    BorderThickness="2,0,0,0"
                    CornerRadius="6"
                    Padding="8,4"
                    Margin="0,1">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceHover}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceHover}" />
              </Trigger>
              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentSubtle}" />
                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Accent}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="FileRowTemplate" DataType="{x:Type vm:FileDiffViewModel}">
      <Button Style="{StaticResource FileRow}"
              Command="{Binding DataContext.SelectFileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
              CommandParameter="{Binding}"
              ToolTip="{Binding Tooltip}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Path Grid.Column="0"
                Data="M2,1 L8,1 L11,4 L11,14 L2,14 Z M8,1 L8,4 L11,4"
                Stroke="{DynamicResource TextMuted}"
                StrokeThickness="1.3"
                StrokeLineJoin="Round"
                Width="10"
                Height="13"
                Stretch="Uniform"
                VerticalAlignment="Center" />

          <!-- The name first, the folder dimmed after it; the counts wait in the tooltip and on
               the bar above the diff, where there is room for them. -->
          <TextBlock Grid.Column="1"
                     Margin="9,0,8,0"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"><Run Text="{Binding FileName, Mode=OneWay}" Foreground="{DynamicResource TextPrimary}" /><Run Text="  " /><Run Text="{Binding Folder, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" FontSize="11" /></TextBlock>

          <TextBlock x:Name="Letter"
                     Grid.Column="2"
                     Text="{Binding StatusLetter}"
                     VerticalAlignment="Center"
                     Width="14"
                     TextAlignment="Center"
                     FontFamily="{StaticResource CodeFont}"
                     FontSize="11.5"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondary}"
                     ToolTip="{Binding Status}" />
        </Grid>
      </Button>

      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsAdded}" Value="True">
          <Setter TargetName="Letter" Property="Foreground" Value="{DynamicResource DiffAddedAccent}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsDeleted}" Value="True">
          <Setter TargetName="Letter" Property="Foreground" Value="{DynamicResource DiffRemovedAccent}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- One row of a unified diff: the two line numbers, the +/- marker, then the code. -->
    <DataTemplate x:Key="DiffLineTemplate" DataType="{x:Type vm:DiffLineViewModel}">
      <Border x:Name="Row" Background="Transparent">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="38" />
            <ColumnDefinition Width="38" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0"
                     Text="{Binding OldNumber}"
                     FontFamily="{StaticResource CodeFont}"
                     FontSize="11"
                     Foreground="{DynamicResource DiffGutterText}"
                     TextAlignment="Right"
                     Padding="0,1,8,1" />

          <TextBlock Grid.Column="1"
                     Text="{Binding NewNumber}"
                     FontFamily="{StaticResource CodeFont}"
                     FontSize="11"
                     Foreground="{DynamicResource DiffGutterText}"
                     TextAlignment="Right"
                     Padding="0,1,8,1" />

          <TextBlock x:Name="Marker"
                     Grid.Column="2"
                     Text="{Binding Marker}"
                     FontFamily="{StaticResource CodeFont}"
                     FontSize="11.5"
                     Foreground="{DynamicResource DiffGutterText}"
                     Padding="0,1,0,1" />

          <TextBlock x:Name="Code"
                     Grid.Column="3"
                     Text="{Binding Text}"
                     FontFamily="{StaticResource CodeFont}"
                     FontSize="11.5"
                     Foreground="{DynamicResource DiffCodeText}"
                     Padding="0,1,10,1"
                     TextWrapping="NoWrap" />
        </Grid>
      </Border>

      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:DiffLineKind.Added}">
          <Setter TargetName="Row" Property="Background" Value="{DynamicResource DiffAddedBackground}" />
          <Setter TargetName="Marker" Property="Foreground" Value="{DynamicResource DiffAddedAccent}" />
        </DataTrigger>

        <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:DiffLineKind.Removed}">
          <Setter TargetName="Row" Property="Background" Value="{DynamicResource DiffRemovedBackground}" />
          <Setter TargetName="Marker" Property="Foreground" Value="{DynamicResource DiffRemovedAccent}" />
        </DataTrigger>

        <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:DiffLineKind.Hunk}">
          <Setter TargetName="Row" Property="Background" Value="{DynamicResource DiffHunkBackground}" />
          <Setter TargetName="Code" Property="Foreground" Value="{DynamicResource DiffHunkText}" />
        </DataTrigger>

        <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:DiffLineKind.Note}">
          <Setter TargetName="Code" Property="Foreground" Value="{DynamicResource TextMuted}" />
          <Setter TargetName="Code" Property="FontStyle" Value="Italic" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

  </Window.Resources>

  <Border Background="{DynamicResource Surface}"
          BorderBrush="{DynamicResource Border}"
          BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ==================== Header ==================== -->

      <Grid Grid.Row="0" Margin="16,14,10,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Viewbox Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
          <Path Data="{x:Static platform:IconArtwork.BellGeometry}" Fill="{DynamicResource Accent}" />
        </Viewbox>

        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="GitAlert" Style="{StaticResource TitleText}" />

          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}"
                       Style="{StaticResource MutedText}"
                       Margin="6,0,0,0"
                       MaxWidth="320"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <TextBlock Text="&#183;"
                       Style="{StaticResource MutedText}"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       Visibility="{Binding LastUpdatedText, Converter={StaticResource StringToVisibility}}" />
            <TextBlock Text="{Binding LastUpdatedText}"
                       Style="{StaticResource MutedText}"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       Visibility="{Binding LastUpdatedText, Converter={StaticResource StringToVisibility}}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">

          <Button Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" ToolTip="Check now">
            <Canvas Width="16" Height="16">
              <Path Data="M13.4,8 A5.4,5.4 0 1 1 11.2,3.7"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.6"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round" />
              <Path Data="M11.9,1.3 L12.6,4.8 L9.1,4.4 Z"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Canvas>
          </Button>

          <!-- A pushpin, not a map marker: the button keeps the window on top, and the marker
               read as "location" to everyone who did not already know. -->
          <Button x:Name="PinButton" Style="{StaticResource IconButton}" Click="OnPinClicked" ToolTip="Keep on top">
            <Path Width="15"
                  Height="15"
                  Stretch="Uniform"
                  Data="M5.5,1.2 L10.5,1.2 A0.7,0.7 0 0 1 10.5,2.6 L10.1,2.6 L10.1,6.4 L12.4,8.6 A1,1 0 0 1 12.7,9.3 L12.7,9.6 A0.6,0.6 0 0 1 12.1,10.2 L8.7,10.2 L8.7,14.2 L8,15.2 L7.3,14.2 L7.3,10.2 L3.9,10.2 A0.6,0.6 0 0 1 3.3,9.6 L3.3,9.3 A1,1 0 0 1 3.6,8.6 L5.9,6.4 L5.9,2.6 L5.5,2.6 A0.7,0.7 0 0 1 5.5,1.2 Z">
              <Path.Style>
                <Style TargetType="Path">
                  <Setter Property="Fill" Value="{DynamicResource TextMuted}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Topmost, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                      <Setter Property="Fill" Value="{DynamicResource Accent}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Path.Style>
            </Path>
          </Button>

          <Button Style="{StaticResource IconButton}" Command="{Binding ShowSettingsCommand}" ToolTip="Settings">
            <Canvas Width="16" Height="16">
              <Path Data="M8,5.4 A2.6,2.6 0 1 0 8,10.6 A2.6,2.6 0 1 0 8,5.4 Z"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.5" />
              <Path Data="M8,1.2 L8,3.1 M8,12.9 L8,14.8 M14.8,8 L12.9,8 M3.1,8 L1.2,8 M12.8,3.2 L11.5,4.5 M4.5,11.5 L3.2,12.8 M12.8,12.8 L11.5,11.5 M4.5,4.5 L3.2,3.2"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.5"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round" />
            </Canvas>
          </Button>

          <Button x:Name="CloseButton"
                  Style="{StaticResource IconButton}"
                  Click="OnCloseClicked"
                  ToolTip="Close">
            <Path Data="M3.4,3.4 L12.6,12.6 M12.6,3.4 L3.4,12.6"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.6"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- ==================== Filters ==================== -->

      <StackPanel Grid.Row="1" Margin="16,0,14,8">

        <!-- Both filters on one row: what kind, and whether read alerts count. A row per
             control cost more height than the first alert was worth. -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <ItemsControl Grid.Column="0" ItemsSource="{Binding Filters}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource FilterChip}"
                        Margin="0,0,4,5"
                        Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Grid.Column="1"
                  CornerRadius="13"
                  Padding="2"
                  Margin="8,0,0,5"
                  VerticalAlignment="Top"
                  Background="{DynamicResource ChipBackground}">
            <Button Style="{StaticResource ModeChip}"
                    Content="Unread only"
                    Tag="{Binding UnreadOnly}"
                    ToolTip="Show only alerts you have not read, and only the projects that have some"
                    Command="{Binding ToggleUnreadOnlyCommand}" />
          </Border>
        </Grid>
      </StackPanel>

      <!-- ==================== List and detail ==================== -->

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
          <!-- Proportional rather than fixed: a fixed list column would starve the detail
               pane instead of shrinking with it when the window is dragged narrow. -->
          <ColumnDefinition x:Name="ListColumn" Width="0.6*" MinWidth="250" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition x:Name="DetailColumn" Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- Alerts -->
        <Grid Grid.Column="0">
          <ScrollViewer Style="{StaticResource SlimScrollViewer}"
                        Margin="8,0,4,0"
                        Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
            <!-- A background, so a drop in the space under the last project still lands. The
                 bring-into-view handler keeps a click from scrolling the list. -->
            <ItemsControl ItemsSource="{Binding Groups}"
                          ItemTemplate="{StaticResource ProjectGroupTemplate}"
                          Margin="0,0,4,8"
                          Background="Transparent"
                          RequestBringIntoView="OnListRequestBringIntoView"
                          AllowDrop="True"
                          DragOver="OnGroupsDragOver"
                          DragLeave="OnGroupsDragLeave"
                          Drop="OnGroupsDrop" />
          </ScrollViewer>

          <StackPanel VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      Margin="28,24,28,32"
                      Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <Viewbox Width="34" Height="34" Opacity="0.28" HorizontalAlignment="Center">
              <Path Data="{x:Static platform:IconArtwork.BellGeometry}" Fill="{DynamicResource TextMuted}" />
            </Viewbox>
            <TextBlock Text="{Binding EmptyMessage}"
                       Style="{StaticResource SecondaryText}"
                       Margin="0,12,0,0"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="240" />
          </StackPanel>
        </Grid>

        <!-- Where it is left is kept with the window's placement, like its size. -->
        <GridSplitter Grid.Column="1"
                      Width="4"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      ShowsPreview="False"
                      DragCompleted="OnListSplitterDragCompleted" />

        <!-- The diff of whichever file is picked under the open alert. The alert, its count and
             its actions are all on the card, so the pane carries nothing but the file. -->
        <Border Grid.Column="2"
                BorderBrush="{DynamicResource BorderSubtle}"
                BorderThickness="1,0,0,0"
                Background="{DynamicResource SurfaceSunken}">
          <ContentControl Content="{Binding Detail}">
            <ContentControl.ContentTemplate>
              <DataTemplate DataType="{x:Type vm:AlertDetailViewModel}">
                <Grid>
                  <!-- Nothing picked yet. -->
                  <StackPanel VerticalAlignment="Center"
                              HorizontalAlignment="Center"
                              Margin="30"
                              Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}">
                    <TextBlock Text="Nothing selected"
                               Style="{StaticResource SecondaryText}"
                               FontSize="13.5"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Pick an alert or a commit. The files it changed unfold under it, and the diff of the one you pick opens here."
                               Style="{StaticResource MutedText}"
                               Margin="0,6,0,0"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="280" />
                  </StackPanel>

                  <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <Grid Visibility="{Binding HasSelectedFile, Converter={StaticResource BoolToVisibility}}">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <!-- The file bar: where the file lives, dimmed, then its name, then its counts. -->
                      <Border Grid.Row="0"
                              Padding="14,10,10,10"
                              Background="{DynamicResource SurfaceElevated}"
                              BorderBrush="{DynamicResource BorderSubtle}"
                              BorderThickness="0,0,0,1">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <TextBlock Grid.Column="0"
                                     FontFamily="{StaticResource CodeFont}"
                                     FontSize="11.5"
                                     VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip="{Binding SelectedFile.Tooltip}"><Run Text="{Binding SelectedFile.Folder, Mode=OneWay}" Foreground="{DynamicResource TextMuted}" /><Run Text="{Binding SelectedFile.FileName, Mode=OneWay}" Foreground="{DynamicResource TextPrimary}" FontWeight="SemiBold" /></TextBlock>

                          <TextBlock Grid.Column="1"
                                     VerticalAlignment="Center"
                                     Margin="12,0,6,0"
                                     FontFamily="{StaticResource CodeFont}"
                                     FontSize="10.5"><Run Text="{Binding SelectedFile.Additions, Mode=OneWay, StringFormat=+{0}}" Foreground="{DynamicResource DiffAddedAccent}" /><Run Text="  " /><Run Text="{Binding SelectedFile.Deletions, Mode=OneWay, StringFormat=-{0}}" Foreground="{DynamicResource DiffRemovedAccent}" /></TextBlock>

                          <Button Grid.Column="2"
                                  Content="Open file"
                                  Style="{StaticResource GhostButton}"
                                  Command="{Binding SelectedFile.OpenOnGitHubCommand}" />
                        </Grid>
                      </Border>

                      <ScrollViewer Grid.Row="1"
                                    Style="{StaticResource SlimScrollViewer}"
                                    HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding SelectedFile.Lines}"
                                      ItemTemplate="{StaticResource DiffLineTemplate}"
                                      VerticalAlignment="Top" />
                      </ScrollViewer>

                      <TextBlock Grid.Row="2"
                                 Text="{Binding SelectedFile.Note}"
                                 Margin="14,8,12,10"
                                 FontSize="11.5"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextMuted}"
                                 Visibility="{Binding SelectedFile.HasNote, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>

                    <TextBlock Text="Fetching the changed files from GitHub&#8230;"
                               Style="{StaticResource SecondaryText}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding Error}"
                               Foreground="{DynamicResource Danger}"
                               FontSize="12.5"
                               Margin="30"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Text="{Binding Notice}"
                               Style="{StaticResource MutedText}"
                               Margin="30"
                               MaxWidth="320"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}" />
                  </Grid>
                </Grid>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </Border>
      </Grid>

      <!-- ==================== Footer ==================== -->

      <Border Grid.Row="3"
              BorderBrush="{DynamicResource BorderSubtle}"
              BorderThickness="0,1,0,0"
              Padding="12,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="6,0,0,0">
            <TextBlock Text="{Binding UnreadText}" Style="{StaticResource MutedText}" />
            <TextBlock Text="{Binding RateLimitText}"
                       Style="{StaticResource MutedText}"
                       FontSize="10.5"
                       Opacity="0.75"
                       Visibility="{Binding RateLimitText, Converter={StaticResource StringToVisibility}}" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Content="Mark all read"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding MarkAllReadCommand}"
                    IsEnabled="{Binding HasUnread}" />
            <Button Content="Quit"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding QuitCommand}" />
          </StackPanel>
        </Grid>
      </Border>

    </Grid>
  </Border>
</Window>

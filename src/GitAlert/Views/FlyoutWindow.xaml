<Window x:Class="GitAlert.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GitAlert.ViewModels"
        xmlns:platform="clr-namespace:GitAlert.Platform"
        Title="GitAlert"
        Width="440"
        SizeToContent="Height"
        MaxHeight="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal">

  <Window.Resources>

    <!-- The whole alert row is a button, so it is keyboard reachable and gets a real hover state. -->
    <Style x:Key="AlertCard" TargetType="Button">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bg"
                    Background="Transparent"
                    CornerRadius="9"
                    Padding="10,9"
                    Margin="0,1">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceHover}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceHover}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <DataTemplate x:Key="AlertTemplate" DataType="{x:Type vm:AlertViewModel}">
      <Button Style="{StaticResource AlertCard}"
              Command="{Binding DataContext.OpenAlertCommand, RelativeSource={RelativeSource AncestorType=Window}}"
              CommandParameter="{Binding}"
              ToolTip="{Binding Tooltip}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <!-- Kind badge: the glyph in its accent colour on a tile tinted with the same hue. -->
          <Border Grid.Column="0"
                  Width="30"
                  Height="30"
                  CornerRadius="8"
                  Background="{Binding Accent}"
                  Opacity="0.16"
                  VerticalAlignment="Top" />

          <Path Grid.Column="0"
                Data="{Binding Glyph}"
                Fill="{Binding Accent}"
                Width="16"
                Height="16"
                Stretch="Uniform"
                Margin="0,7,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top" />

          <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center">
            <TextBlock x:Name="TitleLine"
                       Text="{Binding Title}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Text="{Binding Detail}"
                       FontSize="12"
                       Margin="0,2,0,0"
                       Foreground="{DynamicResource TextSecondary}"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Text="{Binding Meta}"
                       FontSize="11.5"
                       Margin="0,3,0,0"
                       Foreground="{DynamicResource TextMuted}"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <StackPanel Grid.Column="2" VerticalAlignment="Top" Margin="0,1,0,0">
            <TextBlock Text="{Binding Age}"
                       FontSize="11.5"
                       Foreground="{DynamicResource TextMuted}"
                       HorizontalAlignment="Right" />

            <Ellipse x:Name="UnreadDot"
                     Width="7"
                     Height="7"
                     Margin="0,6,1,0"
                     Fill="{DynamicResource Accent}"
                     HorizontalAlignment="Right" />
          </StackPanel>
        </Grid>

      </Button>

      <!-- Read alerts lose the dot and the emphasis, but stay in the list. -->
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsRead}" Value="True">
          <Setter TargetName="UnreadDot" Property="Visibility" Value="Hidden" />
          <Setter TargetName="TitleLine" Property="FontWeight" Value="Normal" />
          <Setter TargetName="TitleLine" Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

  </Window.Resources>

  <!-- The outer margin is the drop shadow's room to breathe. -->
  <Border Margin="14"
          CornerRadius="12"
          Background="{DynamicResource Surface}"
          BorderBrush="{DynamicResource Border}"
          BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.38" Color="#000000" />
    </Border.Effect>

    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <!-- ==================== Header ==================== -->

      <Grid Grid.Row="0" Margin="16,14,10,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Viewbox Grid.Column="0" Width="20" Height="20" VerticalAlignment="Center">
          <Path Data="{x:Static platform:IconArtwork.BellGeometry}" Fill="{DynamicResource Accent}" />
        </Viewbox>

        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="GitAlert" Style="{StaticResource TitleText}" />

          <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}"
                       Style="{StaticResource MutedText}"
                       Margin="6,0,0,0"
                       MaxWidth="220"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding LastUpdatedText}"
                       Style="{StaticResource MutedText}"
                       Margin="6,0,0,0"
                       VerticalAlignment="Center"
                       Visibility="{Binding LastUpdatedText, Converter={StaticResource StringToVisibility}}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource IconButton}" Command="{Binding RefreshCommand}" ToolTip="Check now">
            <Canvas Width="16" Height="16">
              <Path Data="M13.4,8 A5.4,5.4 0 1 1 11.2,3.7"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.6"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round" />
              <Path Data="M11.9,1.3 L12.6,4.8 L9.1,4.4 Z"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            </Canvas>
          </Button>

          <Button Style="{StaticResource IconButton}" Command="{Binding ShowSettingsCommand}" ToolTip="Settings">
            <Canvas Width="16" Height="16">
              <Path Data="M8,5.4 A2.6,2.6 0 1 0 8,10.6 A2.6,2.6 0 1 0 8,5.4 Z"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.5" />
              <Path Data="M8,1.2 L8,3.1 M8,12.9 L8,14.8 M14.8,8 L12.9,8 M3.1,8 L1.2,8 M12.8,3.2 L11.5,4.5 M4.5,11.5 L3.2,12.8 M12.8,12.8 L11.5,11.5 M4.5,4.5 L3.2,3.2"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                    StrokeThickness="1.5"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round" />
            </Canvas>
          </Button>

          <Button x:Name="CloseButton"
                  Style="{StaticResource IconButton}"
                  Click="OnCloseClicked"
                  ToolTip="Close">
            <Path Data="M3.4,3.4 L12.6,12.6 M12.6,3.4 L3.4,12.6"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.6"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
          </Button>
        </StackPanel>
      </Grid>

      <!-- ==================== Filters ==================== -->

      <ItemsControl Grid.Row="1" ItemsSource="{Binding Filters}" Margin="16,0,16,10">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource FilterChip}"
                    Margin="0,0,4,5"
                    Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- ==================== Alerts ==================== -->

      <Grid Grid.Row="2" MinHeight="120">
        <ScrollViewer Style="{StaticResource SlimScrollViewer}"
                      MaxHeight="420"
                      Margin="8,0,6,0"
                      Visibility="{Binding IsEmpty, Converter={StaticResource InverseBoolToVisibility}}">
          <ItemsControl ItemsSource="{Binding Alerts}"
                        ItemTemplate="{StaticResource AlertTemplate}"
                        Margin="0,0,4,8" />
        </ScrollViewer>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="32,24,32,32"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
          <Viewbox Width="34" Height="34" Opacity="0.28" HorizontalAlignment="Center">
            <Path Data="{x:Static platform:IconArtwork.BellGeometry}" Fill="{DynamicResource TextMuted}" />
          </Viewbox>
          <TextBlock Text="{Binding EmptyMessage}"
                     Style="{StaticResource SecondaryText}"
                     Margin="0,12,0,0"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     MaxWidth="260" />
        </StackPanel>
      </Grid>

      <!-- ==================== Footer ==================== -->

      <Border Grid.Row="3"
              BorderBrush="{DynamicResource BorderSubtle}"
              BorderThickness="0,1,0,0"
              Padding="12,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="6,0,0,0">
            <TextBlock Text="{Binding UnreadText}" Style="{StaticResource MutedText}" />
            <TextBlock Text="{Binding RateLimitText}"
                       Style="{StaticResource MutedText}"
                       FontSize="10.5"
                       Opacity="0.75"
                       Visibility="{Binding RateLimitText, Converter={StaticResource StringToVisibility}}" />
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Content="Mark all read"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding MarkAllReadCommand}"
                    IsEnabled="{Binding HasUnread}" />
            <Button Content="Quit"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding QuitCommand}" />
          </StackPanel>
        </Grid>
      </Border>

    </Grid>
  </Border>
</Window>

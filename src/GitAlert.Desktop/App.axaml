<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GitAlert.App"
             RequestedThemeVariant="Dark">

  <!-- The palette sits first in the merged dictionaries; ThemeService swaps it at runtime. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://GitAlert.Desktop/Themes/Dark.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://GitAlert.Desktop/Themes/Controls.axaml" />
    <StyleInclude Source="avares://GitAlert.Desktop/Themes/Inputs.axaml" />
  </Application.Styles>

</Application>

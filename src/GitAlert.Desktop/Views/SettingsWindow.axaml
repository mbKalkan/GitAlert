<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="using:System"
        xmlns:vm="using:GitAlert.ViewModels"
        xmlns:cfg="using:GitAlert.Configuration"
        xmlns:gfx="using:GitAlert.Graphics"
        x:Class="GitAlert.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="GitAlert settings"
        Width="820"
        Height="640"
        MinWidth="720"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface}"
        Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True"
        Icon="avares://GitAlert/Assets/app.ico">

  <Window.Resources>

    <!-- One repository row inside an account card. The nearest ItemsControl ancestor is the
         repository list, whose DataContext is the owning account. -->
    <DataTemplate x:Key="RepositoryRow" x:DataType="vm:RepoItemViewModel">
      <Border Background="Transparent" CornerRadius="6" Padding="8,6" Margin="0,1">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <CheckBox Grid.Column="0"
                    Theme="{StaticResource ModernCheckBox}"
                    Margin="0"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsEnabled}"
                    ToolTip.Tip="Check this repository during each poll" />

          <TextBlock Grid.Column="1"
                     Text="{Binding FullName}"
                     FontSize="12.5"
                     Margin="10,0,0,0"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis" />

          <Border Grid.Column="2"
                  Background="{DynamicResource ChipBackground}"
                  CornerRadius="9"
                  Padding="7,2"
                  Margin="0,0,6,0"
                  VerticalAlignment="Center"
                  IsVisible="{Binding IsPrivate}">
            <TextBlock Text="Private" Classes="muted" FontSize="10.5" />
          </Border>

          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Theme="{StaticResource GhostButton}"
                    Content="Open"
                    Padding="7,3"
                    Command="{Binding $parent[ItemsControl].((vm:AccountViewModel)DataContext).OpenRepositoryCommand}"
                    CommandParameter="{Binding}" />
            <Button Theme="{StaticResource GhostButton}"
                    Content="Remove"
                    Padding="7,3"
                    Command="{Binding $parent[ItemsControl].((vm:AccountViewModel)DataContext).RemoveRepositoryCommand}"
                    CommandParameter="{Binding}" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>

    <!-- A repository the token can reach, offered as a tick box. Ticking it edits the watched list above. -->
    <DataTemplate x:Key="DiscoveredRepositoryRow" x:DataType="vm:DiscoveredRepoViewModel">
      <Border Background="Transparent" Padding="2,1">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto">
          <CheckBox Grid.Column="0"
                    Theme="{StaticResource ModernCheckBox}"
                    Margin="0"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsWatched}" />

          <TextBlock Grid.Column="1"
                     Margin="4,0,10,0"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     ToolTip.Tip="{Binding Description}"><Run Text="{Binding OwnerPrefix}" Foreground="{DynamicResource TextMuted}" /><Run Text="{Binding Name}" Foreground="{DynamicResource TextPrimary}" /></TextBlock>

          <Border Grid.Column="2"
                  Margin="0,0,8,0"
                  Padding="6,1"
                  CornerRadius="4"
                  VerticalAlignment="Center"
                  Background="{DynamicResource ChipBackground}"
                  IsVisible="{Binding IsPrivate}">
            <TextBlock Text="private" FontSize="10" Foreground="{DynamicResource TextSecondary}" />
          </Border>

          <TextBlock Grid.Column="3"
                     Text="{Binding Activity}"
                     Classes="muted"
                     FontSize="11"
                     VerticalAlignment="Center" />
        </Grid>
      </Border>
    </DataTemplate>

    <!-- One GitHub account, with the repositories watched under it. -->
    <DataTemplate x:Key="AccountCard" x:DataType="vm:AccountViewModel">
      <Border Background="{DynamicResource SurfaceElevated}"
              BorderBrush="{DynamicResource BorderSubtle}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="16,14"
              Margin="0,0,0,12">
        <StackPanel>

          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Grid.Column="0"
                    Width="30"
                    Height="30"
                    CornerRadius="15"
                    Background="{DynamicResource AccentSubtle}"
                    VerticalAlignment="Center">
              <Path Data="M8,2 A3.2,3.2 0 1 1 8,8.4 A3.2,3.2 0 1 1 8,2 Z M2.4,14.4 C2.4,11.3 4.9,9.6 8,9.6 C11.1,9.6 13.6,11.3 13.6,14.4 Z"
                    Fill="{DynamicResource Accent}"
                    Width="15"
                    Height="15"
                    Stretch="Uniform"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" />
              <TextBlock Text="{Binding RepositorySummary}" Classes="muted" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <CheckBox Theme="{StaticResource ModernCheckBox}"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        IsChecked="{Binding IsEnabled}"
                        Content="Active"
                        ToolTip.Tip="Uncheck to pause this account without removing it" />
              <Button Theme="{StaticResource GhostButton}"
                      Content="Replace token"
                      Command="{Binding BeginReplaceTokenCommand}" />
              <Button Theme="{StaticResource GhostButton}"
                      Content="Remove"
                      Command="{Binding RemoveCommand}" />
            </StackPanel>
          </Grid>

          <!-- Shown when the stored token could not be decrypted, which needs a new one. -->
          <Border Background="{DynamicResource ChipBackground}"
                  CornerRadius="7"
                  Padding="10,7"
                  Margin="0,12,0,0">
            <Border.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="!HasStoredToken" />
                <Binding Path="!IsReplacingToken" />
              </MultiBinding>
            </Border.IsVisible>
            <TextBlock Classes="secondary"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource Danger}"
                       Text="No usable token for this account. Choose Replace token to sign in again." />
          </Border>

          <!-- Replace-token panel. -->
          <Grid Margin="0,12,0,0" ColumnDefinitions="*,Auto,Auto" IsVisible="{Binding IsReplacingToken}">
            <!-- No undo history: a secret cleared from the box must not come back with Ctrl+Z. -->
            <TextBox Grid.Column="0"
                     Theme="{StaticResource ModernTextBox}"
                     PasswordChar="●"
                     IsUndoEnabled="False"
                     Text="{Binding ReplacementToken}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding ApplyTokenCommand}" />
              </TextBox.KeyBindings>
            </TextBox>

            <Button Grid.Column="1"
                    Content="Save token"
                    Theme="{StaticResource PrimaryButton}"
                    Margin="8,0,0,0"
                    Command="{Binding ApplyTokenCommand}"
                    IsEnabled="{Binding !IsBusy}" />

            <Button Grid.Column="2"
                    Content="Cancel"
                    Theme="{StaticResource GhostButton}"
                    Margin="4,0,0,0"
                    Command="{Binding CancelReplaceTokenCommand}" />
          </Grid>

          <CheckBox Theme="{StaticResource ModernCheckBox}"
                    Margin="0,14,0,4"
                    IsChecked="{Binding IncludeInbox}"
                    Content="Watch this account's inbox (mentions, review requests, assignments)" />

          <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,8,0,12" />

          <TextBlock Text="REPOSITORIES" Classes="section" />

          <Grid Margin="0,0,0,8" ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0"
                     Theme="{StaticResource ModernTextBox}"
                     PlaceholderText="https://github.com/owner/repository"
                     Text="{Binding NewRepositoryInput}">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding AddRepositoryCommand}" />
              </TextBox.KeyBindings>
            </TextBox>

            <Button Grid.Column="1"
                    Content="Add repository"
                    Theme="{StaticResource SecondaryButton}"
                    Margin="8,0,0,0"
                    Command="{Binding AddRepositoryCommand}"
                    IsEnabled="{Binding !IsBusy}" />
          </Grid>

          <ItemsControl ItemsSource="{Binding Repositories}" ItemTemplate="{StaticResource RepositoryRow}" />

          <TextBlock Text="Nothing watched under this account yet."
                     Classes="muted"
                     Margin="8,4,0,0"
                     IsVisible="{Binding Repositories.Count, Converter={StaticResource Equals}, ConverterParameter=0}" />

          <Border Height="1" Background="{DynamicResource BorderSubtle}" Margin="0,14,0,12" />

          <Grid Margin="0,0,0,8" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       Text="AVAILABLE TO THIS TOKEN"
                       Classes="section"
                       Margin="0"
                       VerticalAlignment="Center" />

            <Button Grid.Column="1"
                    Content="Find repositories"
                    Theme="{StaticResource SecondaryButton}"
                    Command="{Binding DiscoverCommand}"
                    IsEnabled="{Binding !IsDiscovering}" />
          </Grid>

          <TextBlock Classes="muted"
                     Margin="0,0,0,8"
                     TextWrapping="Wrap"
                     IsVisible="{Binding !HasDiscovered}"
                     Text="Everything this token can reach - your own repositories, the ones you collaborate on, and your organisations' - listed to tick rather than typed out." />

          <TextBlock Text="Asking GitHub what this token can see&#8230;"
                     Classes="muted"
                     Margin="0,0,0,8"
                     IsVisible="{Binding IsDiscovering}" />

          <StackPanel IsVisible="{Binding HasDiscovered}">

            <Grid Margin="0,0,0,8" ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0"
                       Theme="{StaticResource ModernTextBox}"
                       PlaceholderText="Search"
                       Text="{Binding RepositoryFilter}" />

              <ComboBox Grid.Column="1"
                        Classes="modern"
                        Width="170"
                        Margin="8,0,0,0"
                        ItemsSource="{Binding SortOptions}"
                        SelectedItem="{Binding SelectedSort}">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:RepoSortOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>

            <TextBlock Text="{Binding DiscoverySummary}" Classes="muted" Margin="2,0,0,6" />

            <Border BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="4">
              <ScrollViewer MaxHeight="240">
                <ItemsControl ItemsSource="{Binding DiscoveredRepositories}"
                              ItemTemplate="{StaticResource DiscoveredRepositoryRow}" />
              </ScrollViewer>
            </Border>

            <TextBlock Text="Nothing matches that search."
                       Classes="muted"
                       Margin="4,6,0,0"
                       IsVisible="{Binding DiscoveredRepositories.Count, Converter={StaticResource Equals}, ConverterParameter=0}" />
          </StackPanel>

          <!-- The note under the card, red when it reports a problem. -->
          <TextBlock Classes="muted inlineMessage"
                     Classes.error="{Binding IsMessageError}"
                     Text="{Binding Message}"
                     IsVisible="{Binding HasMessage}" />

        </StackPanel>
      </Border>
    </DataTemplate>

  </Window.Resources>

  <Window.Styles>
    <Style Selector="TextBlock.pageTitle">
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.pageSubtitle">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,0,0,18" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="TextBlock.inlineMessage">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style Selector="TextBlock.inlineMessage.error">
      <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    </Style>
    <Style Selector="TextBlock.footerMessage">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.footerMessage.error">
      <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    </Style>
    <Style Selector="Border.rule">
      <Setter Property="Height" Value="1" />
      <Setter Property="Background" Value="{DynamicResource BorderSubtle}" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="196,*">

    <!-- ==================== Navigation ==================== -->

    <Border Grid.Column="0"
            Background="{DynamicResource SurfaceSunken}"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="0,0,1,0">
      <DockPanel Margin="12,16,12,12">

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,18">
          <Viewbox Width="22" Height="22">
            <Path Data="{x:Static gfx:Bell.Geometry}" Fill="{DynamicResource Accent}" />
          </Viewbox>
          <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="GitAlert" Classes="title" />
            <TextBlock Text="{Binding Version, StringFormat='v{0}'}" Classes="muted" />
          </StackPanel>
        </StackPanel>

        <ListBox Name="Navigation" DockPanel.Dock="Top" Classes="nav" SelectedIndex="0">
          <ListBoxItem Content="Accounts" />
          <ListBoxItem Content="Notifications" />
          <ListBoxItem Content="General" />
          <ListBoxItem Content="About" />
        </ListBox>

      </DockPanel>
    </Border>

    <!-- ==================== Pages ==================== -->

    <Grid Grid.Column="1" RowDefinitions="*,Auto">

      <Panel Grid.Row="0">

        <!-- ========== Accounts ========== -->
        <Grid Margin="28,26,28,16"
              RowDefinitions="Auto,Auto,*"
              IsVisible="{Binding #Navigation.SelectedIndex, Converter={StaticResource Equals}, ConverterParameter=0}">

          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Margin="0,0,16,0">
              <TextBlock Text="GitHub accounts" Classes="pageTitle" />
              <TextBlock Classes="pageSubtitle"
                         Text="Add an account for each token you have, then add repositories under the account whose token can see them. A work account and a personal account sit side by side." />
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Add account"
                    Theme="{StaticResource PrimaryButton}"
                    VerticalAlignment="Top"
                    Command="{Binding BeginAddAccountCommand}"
                    IsVisible="{Binding !IsAddingAccount}" />
          </Grid>

          <!-- Add-account panel. -->
          <Border Grid.Row="1"
                  Background="{DynamicResource SurfaceElevated}"
                  BorderBrush="{DynamicResource Accent}"
                  BorderThickness="1"
                  CornerRadius="10"
                  Padding="16,14"
                  Margin="0,0,0,14"
                  IsVisible="{Binding IsAddingAccount}">
            <StackPanel>
              <TextBlock Text="Personal access token" Classes="fieldLabel" />
              <TextBlock Classes="muted"
                         TextWrapping="Wrap"
                         Margin="0,0,0,10"
                         Text="Public repositories need no scopes. Add repo for private repositories, and notifications for mentions and review requests. A fine-grained token works too, with read access to Metadata, Contents and Actions on the repositories you watch. The token is encrypted with your Windows account." />

              <Grid ColumnDefinitions="*,Auto,Auto">
                <TextBox Grid.Column="0"
                         Theme="{StaticResource ModernTextBox}"
                         PasswordChar="●"
                         IsUndoEnabled="False"
                         Text="{Binding NewAccountToken}">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding AddAccountCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>

                <Button Grid.Column="1"
                        Content="Add"
                        Theme="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0"
                        Command="{Binding AddAccountCommand}"
                        IsEnabled="{Binding !IsBusy}" />

                <Button Grid.Column="2"
                        Content="Cancel"
                        Theme="{StaticResource GhostButton}"
                        Margin="4,0,0,0"
                        Command="{Binding CancelAddAccountCommand}" />
              </Grid>

              <Button Content="Create a token on GitHub"
                      Theme="{StaticResource GhostButton}"
                      HorizontalAlignment="Left"
                      Margin="-9,8,0,0"
                      Command="{Binding CreateTokenCommand}" />
            </StackPanel>
          </Border>

          <Grid Grid.Row="2">
            <ScrollViewer Margin="0,0,4,0">
              <ItemsControl ItemsSource="{Binding Accounts}" ItemTemplate="{StaticResource AccountCard}" />
            </ScrollViewer>

            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding HasNoAccounts}">
              <Viewbox Width="34" Height="34" Opacity="0.25" HorizontalAlignment="Center">
                <Path Data="{x:Static gfx:Bell.Geometry}" Fill="{DynamicResource TextMuted}" />
              </Viewbox>
              <TextBlock Text="No accounts yet. Add one to get started."
                         Classes="secondary"
                         Margin="0,12,0,0"
                         TextAlignment="Center" />
            </StackPanel>
          </Grid>
        </Grid>

        <!-- ========== Notifications ========== -->
        <ScrollViewer IsVisible="{Binding #Navigation.SelectedIndex, Converter={StaticResource Equals}, ConverterParameter=1}">
          <StackPanel Margin="28,26,28,20">
            <TextBlock Text="What to tell me about" Classes="pageTitle" />
            <TextBlock Classes="pageSubtitle"
                       Text="Switch off anything you would rather not hear about. Muted kinds are neither shown as a toast nor added to the list. These apply to every account." />

            <ItemsControl ItemsSource="{Binding Kinds}" Margin="0,0,0,10">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:KindToggleViewModel">
                  <CheckBox Theme="{StaticResource ModernCheckBox}"
                            Width="230"
                            Content="{Binding Label}"
                            IsChecked="{Binding IsEnabled}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Classes="rule" Margin="0,8,0,18" />

            <TextBlock Text="SOURCES" Classes="section" />

            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       Text="Each account decides for itself whether its inbox is watched; that switch lives on the account card." />

            <CheckBox Theme="{StaticResource ModernCheckBox}"
                      IsChecked="{Binding WatchWorkflowRuns}"
                      Content="Watch GitHub Actions runs" />

            <CheckBox Theme="{StaticResource ModernCheckBox}"
                      Margin="26,0,0,10"
                      IsEnabled="{Binding WatchWorkflowRuns}"
                      IsChecked="{Binding OnlyFailedWorkflowRuns}"
                      Content="Only tell me when a run fails" />

            <CheckBox Theme="{StaticResource ModernCheckBox}"
                      IsChecked="{Binding IgnoreOwnActivity}"
                      Content="Ignore activity I caused myself" />

            <TextBlock Classes="muted"
                       TextWrapping="Wrap"
                       Margin="26,-4,0,10"
                       Text="Off by default, so you see your own pushes too. Turn it on once the echo of your own work stops being useful." />

            <Border Classes="rule" Margin="0,8,0,18" />

            <TextBlock Text="DELIVERY" Classes="section" />

            <CheckBox Theme="{StaticResource ModernCheckBox}"
                      IsChecked="{Binding ShowToasts}"
                      Content="Show a desktop notification for new alerts" />

            <CheckBox Theme="{StaticResource ModernCheckBox}"
                      Margin="26,0,0,10"
                      IsEnabled="{Binding ShowToasts}"
                      IsChecked="{Binding PlaySound}"
                      Content="Play the notification sound" />
          </StackPanel>
        </ScrollViewer>

        <!-- ========== General ========== -->
        <ScrollViewer IsVisible="{Binding #Navigation.SelectedIndex, Converter={StaticResource Equals}, ConverterParameter=2}">
          <StackPanel Margin="28,26,28,20">
            <TextBlock Text="General" Classes="pageTitle" />
            <TextBlock Classes="pageSubtitle"
                       Text="How often GitAlert checks, how it looks, and how much history it keeps." />

            <TextBlock Text="Check for updates" Classes="fieldLabel" />
            <ComboBox Classes="modern"
                      Width="260"
                      HorizontalAlignment="Left"
                      ItemsSource="{Binding PollIntervalOptions}"
                      SelectedItem="{Binding PollIntervalMinutes}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="sys:Int32">
                  <TextBlock Text="{Binding Converter={StaticResource MinutesToText}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="muted"
                       Margin="0,6,0,18"
                       TextWrapping="Wrap"
                       Text="Unchanged data costs nothing against your API budget, so a short interval is usually fine." />

            <TextBlock Text="Appearance" Classes="fieldLabel" />
            <ComboBox Classes="modern"
                      Width="260"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,18"
                      ItemsSource="{Binding ThemeOptions}"
                      SelectedItem="{Binding Theme}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="cfg:AppTheme">
                  <TextBlock Text="{Binding Converter={StaticResource ThemeToText}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Text="Dark palette" Classes="fieldLabel" />
            <ComboBox Classes="modern"
                      Width="260"
                      HorizontalAlignment="Left"
                      ItemsSource="{Binding DarkPaletteOptions}"
                      SelectedItem="{Binding DarkPalette}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="cfg:DarkPalette">
                  <TextBlock Text="{Binding Converter={StaticResource DarkPaletteToText}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock Classes="muted"
                       Margin="0,6,0,18"
                       TextWrapping="Wrap"
                       Text="Used whenever the window comes out dark. Light has the one look." />

            <TextBlock Text="History" Classes="fieldLabel" />
            <ComboBox Classes="modern"
                      Width="260"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,18"
                      ItemsSource="{Binding HistoryOptions}"
                      SelectedItem="{Binding MaxHistory}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="sys:Int32">
                  <TextBlock Text="{Binding Converter={StaticResource HistoryToText}}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <CheckBox Theme="{StaticResource ModernCheckBox}"
                      Margin="0,0,0,14"
                      IsChecked="{Binding StartWithWindows}"
                      Content="Start GitAlert when I sign in" />

            <Border Classes="rule" Margin="0,4,0,18" />

            <TextBlock Text="WINDOW" Classes="section" />

            <CheckBox Theme="{StaticResource ModernCheckBox}"
                      Margin="0,0,0,4"
                      IsChecked="{Binding AutoHideWindow}"
                      Content="Close the window when I click somewhere else" />

            <TextBlock Classes="muted"
                       Margin="26,0,0,14"
                       TextWrapping="Wrap"
                       Text="Off by default, so the window stays put while you read a diff. Turn it on for the quick glance-and-dismiss behaviour of a notification popup." />

            <CheckBox Theme="{StaticResource ModernCheckBox}"
                      Margin="0,0,0,20"
                      IsChecked="{Binding AlwaysOnTop}"
                      Content="Keep the window above other windows" />

            <Border Classes="rule" Margin="0,0,0,18" />

            <TextBlock Text="MAINTENANCE" Classes="section" />

            <StackPanel Orientation="Horizontal">
              <Button Content="Clear alert history"
                      Theme="{StaticResource SecondaryButton}"
                      Margin="0,0,8,0"
                      Command="{Binding ClearHistoryCommand}" />
              <Button Content="Reset sync state"
                      Theme="{StaticResource SecondaryButton}"
                      Margin="0,0,8,0"
                      Command="{Binding ResetStateCommand}" />
              <Button Content="Open data folder"
                      Theme="{StaticResource SecondaryButton}"
                      Command="{Binding OpenDataFolderCommand}" />
            </StackPanel>

            <TextBlock Classes="muted"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       Text="{Binding DataDirectory}" />
          </StackPanel>
        </ScrollViewer>

        <!-- ========== About ========== -->
        <StackPanel Margin="28,26,28,20"
                    IsVisible="{Binding #Navigation.SelectedIndex, Converter={StaticResource Equals}, ConverterParameter=3}">
          <TextBlock Text="About GitAlert" Classes="pageTitle" />
          <TextBlock Classes="pageSubtitle"
                     Text="A small tray app that keeps an eye on the repositories you care about." />

          <Border Background="{DynamicResource SurfaceElevated}"
                  BorderBrush="{DynamicResource BorderSubtle}"
                  BorderThickness="1"
                  CornerRadius="9"
                  Padding="18,16">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Viewbox Width="34" Height="34">
                  <Path Data="{x:Static gfx:Bell.Geometry}" Fill="{DynamicResource Accent}" />
                </Viewbox>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                  <TextBlock Text="GitAlert" FontSize="16" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" Classes="muted" />
                </StackPanel>
              </StackPanel>

              <TextBlock Classes="secondary" TextWrapping="Wrap" Margin="0,0,0,6"
                         Text="Built because tabbing back to GitHub to find out whether anything happened is a poor use of a working day." />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Your tokens stay on this machine, encrypted with your user account. GitAlert talks to api.github.com and nowhere else." />
            </StackPanel>
          </Border>
        </StackPanel>

      </Panel>

      <!-- ==================== Footer ==================== -->

      <Border Grid.Row="1"
              Background="{DynamicResource SurfaceSunken}"
              BorderBrush="{DynamicResource BorderSubtle}"
              BorderThickness="0,1,0,0"
              Padding="20,12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0"
                     Classes="footerMessage"
                     Classes.error="{Binding IsMessageError}"
                     Text="{Binding Message}"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Margin="0,0,16,0" />

          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Content="Cancel"
                    Theme="{StaticResource SecondaryButton}"
                    Margin="0,0,8,0"
                    Command="{Binding CancelCommand}" />
            <Button Content="Save"
                    Theme="{StaticResource PrimaryButton}"
                    Command="{Binding SaveCommand}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>

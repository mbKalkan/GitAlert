<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>GitAlert.Desktop</AssemblyName>
    <RootNamespace>GitAlert</RootNamespace>
    <Description>GitAlert on Avalonia: the same tray app for Windows, macOS and Linux.</Description>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
    <!-- The windows take their view model in the constructor, so the runtime XAML loader could not
         create them anyway; the previewer is not used here. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GitAlert.Core/GitAlert.Core.csproj" />
    <ProjectReference Include="../GitAlert.Windows/GitAlert.Windows.csproj" />
  </ItemGroup>

</Project>

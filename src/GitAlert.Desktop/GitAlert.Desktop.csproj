<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Ships as GitAlert.exe, the name the installer, the Start menu shortcut and the Run entry
         have always pointed at, so an upgrade from the WPF build lands in place. -->
    <AssemblyName>GitAlert</AssemblyName>
    <RootNamespace>GitAlert</RootNamespace>
    <AssemblyTitle>GitAlert</AssemblyTitle>
    <Description>GitAlert on Avalonia: the same tray app for Windows, macOS and Linux.</Description>
    <!-- The runtime identifier belongs to `dotnet publish`, not to the project: pinning it here
         makes a plain restore and a Release build disagree about the assets file. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
    <!-- The windows take their view model in the constructor, so the runtime XAML loader could not
         create them anyway; the previewer is not used here. -->
    <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    <!-- The same artwork the WPF build exports; regenerated there until the cutover. -->
    <ApplicationIcon>../GitAlert/Resources/app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="../GitAlert/Resources/app.ico" Link="Assets/app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../GitAlert.Core/GitAlert.Core.csproj" />
    <ProjectReference Include="../GitAlert.Windows/GitAlert.Windows.csproj" />
  </ItemGroup>

</Project>
